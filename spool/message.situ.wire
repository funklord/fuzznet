# situ wire signature v1
# schema: message.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum fzn_msg_type : u8 unknown=error
  have_query=1 have=2 want=3 data=4

struct fzn_msg_data size=23..
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         fzn_msg_type type  must_eq=data
  @0x0002   4         u32        transfer  big
  @0x0006   8         u64        first  big
  @0x000e   8         u64        count  big max=64
  @0x0016   1         u8         proof_count  max=40
  @0x0017   0..1280   fzn_msg_proof_node siblings  sized-by=proof_count
  ~         0..256    u32        leaf_len  sized-by=count
  ~         0..       u8         payload  sized-by=remaining

struct fzn_msg_have size=60..4156
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         fzn_msg_type type  must_eq=have
  @0x0002   32        u8         root  big
  @0x0022   8         u64        leaf_count  big max=4194304
  @0x002a   16        u8         cookie  big
  @0x003a   2         u16        range_count  big max=256
  @0x003c   0..4096   fzn_msg_range ranges  sized-by=range_count

struct fzn_msg_have_query size=34
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         fzn_msg_type type  must_eq=have_query
  @0x0002   32        u8         root  big

struct fzn_msg_proof_node size=32
  @0x0000   32        u8         hash  big

struct fzn_msg_range size=16
  @0x0000   8         u64        first  big
  @0x0008   8         u64        count  big

struct fzn_msg_want size=70
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         fzn_msg_type type  must_eq=want
  @0x0002   4         u32        transfer  big
  @0x0006   16        u8         cookie  big
  @0x0016   32        u8         root  big
  @0x0036   8         u64        first  big
  @0x003e   8         u64        count  big max=64
