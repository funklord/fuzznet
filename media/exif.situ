// A photograph's own account of itself: the JPEG segments a reader walks to
// reach EXIF, and EXIF's TIFF directory. project.md sec 1447, the photo
// catalogue.
//
// SOURCES. JPEG: ITU T.81 annex B (markers, segment lengths, the frame
// header). EXIF 2.32 (CIPA DC-008), sections 4.5 and 4.6: an APP1 segment
// opening "Exif\0\0", then a TIFF 6.0 header and its directories, offsets
// counted from the TIFF header. The TIFF shapes follow situ's own
// `example/tiff/tiff.situ`, whose directory and byte-order marker were
// proved against real files there.
//
// WHAT C KEEPS (media/tags.c): the walk from segment to segment until the
// scan starts, following a directory's sub-directory pointers, and turning
// a rational into degrees or a date's colons into ISO 8601's dashes. Those
// are a reader's choices over the layouts below, not layouts.

target buffer;

// --- JPEG -----------------------------------------------------------------

// B.1.1.3: every segment after SOI is FF, a marker, and a big-endian length
// counting itself and not the marker. Markers without a length (SOI, EOI,
// RSTn, TEM) never stand where this is read: the walk starts after SOI and
// stops at SOS, the scan.
struct jpeg_segment [endian = big] {
	u8   fill    [must_eq = 0xFF];
	u8   marker  [min = 0xC0, max = 0xFE];
	u16  length  [min = 2];
	u8   body[length - 2];
}

// B.2.2: a frame header (SOF0 to SOF15 but DHT, JPG and DAC) opens with the
// sample precision and the image's size; the components follow and are not
// read here. A height of 0 is "set by the DNL marker later", which a
// catalogue does not wait for.
struct jpeg_frame [endian = big] {
	u8   precision;
	u16  height;
	u16  width   [min = 1];
}

// EXIF 4.5.4: the APP1 segment's body, an identifier and then the TIFF
// header everything after is counted from.
struct exif_app1 {
	u8   identifier[6]  [must_eq = "Exif\0\0"];
}

// --- TIFF, as EXIF carries it ---------------------------------------------

endian_marker byte_order : u16 {
	little = 0x4949,        // "II"
	big    = 0x4D4D,        // "MM"
}

struct tiff_header [endian = from(byte_order)] {
	endian_marker  byte_order;
	u16            magic       [must_eq = 42];
	u32            ifd_offset;
}

require size(tiff_header) == 8;

// TIFF 6.0 section 2. `value` is four bytes whose meaning type and count
// decide: a SHORT sits in the first two, left-justified in either byte
// order, so it is read as two u16s; everything else as the u32 it is --
// a LONG, or the offset of a value longer than four bytes.
struct ifd_entry [endian = from(order)] {
	parameter byte_order order [stream];
	u16 tag;
	u16 type;
	u32 count;
	variant value switch (type) {
		case 3:  u16 shorts[2];
		default: u32 long;
	}
}

struct ifd [endian = from(order)] {
	parameter byte_order order [stream];
	u16                       count;
	ifd_entry(order = order)  entries[count];
	u32                       next;
}

// TIFF 6.0 section 2, type 5: a RATIONAL, two LONGs, at the offset an
// entry's value names. GPS coordinates are three of them -- degrees,
// minutes, seconds.
struct rational [endian = from(order)] {
	parameter byte_order order [stream];
	u32 numerator;
	u32 denominator;
}
