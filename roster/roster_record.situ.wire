# situ wire signature v4
# schema: roster_record.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum fzn_roster_kind : u8 unknown=error
  add=135 remove=136 set=137

struct fzn_chain_hop size=179
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=128
  @0x0002   32        u8         grantor  big
  @0x0022   32        u8         grantee  big
  @0x0042   32        u8         capability  big
  @0x0062   8         u64        issued_at  big
  @0x006a   8         u64        expires_at  big
  @0x0072   1         u8         delegable  max=1
  @0x0073   64        u8         signature
  signature covers: body capability delegable expires_at grantee grantor issued_at object version

struct fzn_roster size=157..349
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         fzn_roster_kind object
  @0x0002   32        u8         writer  big
  @0x0022   32        u8         subject  big
  @0x0042   16        u8         incarnation  big
  @0x0052   8         u64        seq  big
  @0x005a   2         u16        setting  big
  @0x005c   1         u8         body_len  max=192
  @0x005d   0..192    u8         value  sized-by=body_len
  ~         64        u8         signature
  signature covers: body body_len incarnation object seq setting subject value version writer
  fzn_roster refuses: add_or_remove_carries_a_value when fzn_roster.object != 137 && (fzn_roster.body_len != 0 || fzn_roster.setting != 0)
  fzn_roster refuses: no_incarnation when sum(fzn_roster.incarnation) == 0

struct fzn_roster_bundle size=160..1784
  @0x0000   1         u8         hop_count  max=8
  @0x0001   2         u16        record_len  big min=157 max=349
  @0x0003   157..349  u8         record  big sized-by=record_len holds=fzn_roster
  ~         0..1432   fzn_chain_hop hops  sized-by=hop_count
  hops[].signature covers: hops[].body hops[].capability hops[].delegable hops[].expires_at hops[].grantee hops[].grantor hops[].issued_at hops[].object hops[].version
