// The notes sync vocabulary: what one node asks another for so their notes
// converge. notes/sync.c encodes and decodes it by hand, as spool/message.c
// does its own; this is the contract it is measured against. sec 432.
//
// AN INDEX THEN THE RECORDS, sec 432. A node asks a peer for the index
// of what it holds -- each claim's key and sequence, 40 bytes -- and then
// for only the records it lacks or holds older. Fetching every record every
// round would be up to 256 records of up to 668 bytes per peer per round.
//
// THE VERSION IS 2, AND THAT IS THE DISPATCH. These ride the remote hop
// beside spool/message's four, whose version byte is 1; a node offers a
// payload to each family in turn, and a verb line's first byte is a letter.
//
// Big-endian, like everything this tree puts on the wire.

target buffer;
endian big;

enum fzn_notes_sync_type : u8 {
	index_query   = 1,   // "What do you hold, from claim FROM on?"
	index         = 2,   // "These claims, at these sequences."
	records_query = 3,   // "Send me these claims' records."
	records       = 4,   // "Those records, signed as they were made."
	purge         = 5,   // "Erase this note." sec 433
	purge_ack     = 6,   // "I erased it" -- or did not
	purges_query  = 7,   // "Which of your purges pin me?"
	purges        = 8,   // "These."
	writers_query = 9,   // "Who wrote what you share with me?" sec 437
	writers       = 10,  // "These keys."
}

struct fzn_notes_sync_index_query {
	u8                   version [must_eq = 2];
	fzn_notes_sync_type  type    [must_eq = index_query];
	u16                  from;
}

// A claim as an index names it: the key notes/store.c files it under, a
// hash of (note id, writer), and the sequence of the record held for it.
struct fzn_notes_sync_claim {
	u8   key[32];
	u64  seq;
}

struct fzn_notes_sync_index {
	u8                    version [must_eq = 2];
	fzn_notes_sync_type   type    [must_eq = index];
	u16                   total;                     // claims the server offers
	u16                   from;                      // the first in this page
	u16                   count   [max = 256];       // FZN_NOTES_MAX
	fzn_notes_sync_claim  claims[count];
}

struct fzn_notes_sync_key {
	u8   key[32];
}

struct fzn_notes_sync_records_query {
	u8                   version [must_eq = 2];
	fzn_notes_sync_type  type    [must_eq = records_query];
	u8                   count   [min = 1, max = 16];   // FZN_NOTES_SYNC_KEYS_MAX
	fzn_notes_sync_key   keys[count];
}

// A record whole, as record/record.situ lays it out: at most
// FZN_RECORD_MAX_LEN = 92 + 512 + 64 = 668 bytes.
struct fzn_notes_sync_record {
	u16  len [min = 1, max = 668];
	u8   record[len];
}

struct fzn_notes_sync_records {
	u8                     version [must_eq = 2];
	fzn_notes_sync_type    type    [must_eq = records];
	u8                     count   [max = 16];
	fzn_notes_sync_record  records[count];
}

// THE PURGE CONVERSATION, sec 433, driven by the puller both ways: PURGE
// carries its own purges to the node it pulls from, PURGES_QUERY fetches
// that node's purges pinning it, and PURGE_ACK answers either. notes/sync.h
// says why only the puller can drive it.
struct fzn_notes_sync_purge {
	u8                   version [must_eq = 2];
	fzn_notes_sync_type  type    [must_eq = purge];
	u8                   id[32];                     // the note to erase
}

struct fzn_notes_sync_purge_ack {
	u8                   version [must_eq = 2];
	fzn_notes_sync_type  type    [must_eq = purge_ack];
	u8                   id[32];
	u8                   erased  [max = 1];          // 1 erased, 0 not
}

struct fzn_notes_sync_purges_query {
	u8                   version [must_eq = 2];
	fzn_notes_sync_type  type    [must_eq = purges_query];
}

struct fzn_notes_sync_note_id {
	u8   id[32];
}

struct fzn_notes_sync_purges {
	u8                      version [must_eq = 2];
	fzn_notes_sync_type     type    [must_eq = purges];
	u8                      count   [max = 16];      // FZN_NOTES_SYNC_PURGES_MAX
	fzn_notes_sync_note_id  ids[count];
}

// WHO WROTE WHAT IS SHARED, sec 437: asked by a contact under the share
// capability and answered with the distinct writers of the notes the share
// reaches, sorted. The recipient admits exactly these in the sharer's tree.
struct fzn_notes_sync_writers_query {
	u8                   version [must_eq = 2];
	fzn_notes_sync_type  type    [must_eq = writers_query];
}

struct fzn_notes_sync_writer {
	u8   key[32];
}

struct fzn_notes_sync_writers {
	u8                     version [must_eq = 2];
	fzn_notes_sync_type    type    [must_eq = writers];
	u8                     count   [max = 64];       // FZN_NOTES_SYNC_WRITERS_MAX
	fzn_notes_sync_writer  writers[count];
}
