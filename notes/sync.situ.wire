# situ wire signature v2
# schema: sync.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum fzn_notes_sync_type : u8 unknown=error
  index_query=1 index=2 records_query=3 records=4 purge=5 purge_ack=6 purges_query=7 purges=8 writers_query=9 writers=10 members_query=11 members=12 text_push=15 text_pushed=16 wraps_query=17 wraps=18 lacks_query=19 lacks=20 give=21 given=22

struct fzn_notes_sync_claim size=40
  @0x0000   32        u8         key  big
  @0x0020   8         u64        seq  big

struct fzn_notes_sync_give size=3..1027
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=give
  @0x0002   1         u8         count  max=16
  @0x0003   0..1024   fzn_notes_sync_wrap keys  sized-by=count

struct fzn_notes_sync_given size=3
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=given
  @0x0002   1         u8         taken  max=16

struct fzn_notes_sync_hop size=179
  @0x0000   179       u8         bytes  big

struct fzn_notes_sync_index size=8..10248
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=index
  @0x0002   2         u16        total  big
  @0x0004   2         u16        from  big
  @0x0006   2         u16        count  big max=256
  @0x0008   0..10240  fzn_notes_sync_claim claims  sized-by=count

struct fzn_notes_sync_index_query size=4
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=index_query
  @0x0002   2         u16        from  big

struct fzn_notes_sync_key size=32
  @0x0000   32        u8         key  big

struct fzn_notes_sync_lacks size=3..515
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=lacks
  @0x0002   1         u8         count  max=16
  @0x0003   0..512    fzn_notes_sync_note_id ids  sized-by=count

struct fzn_notes_sync_lacks_query size=2
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=lacks_query

struct fzn_notes_sync_member size=212..1465
  @0x0000   32        u8         key  big
  @0x0020   1         u8         hop_count  min=1 max=8
  @0x0021   179..1432 fzn_notes_sync_hop hops  big sized-by=hop_count

struct fzn_notes_sync_members size=7..373582
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=members
  @0x0002   2         u16        total  big
  @0x0004   2         u16        from  big
  @0x0006   1         u8         count
  @0x0007   0..373575 fzn_notes_sync_member members  sized-by=count

struct fzn_notes_sync_members_query size=4
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=members_query
  @0x0002   2         u16        from  big

struct fzn_notes_sync_note_id size=32
  @0x0000   32        u8         id  big

struct fzn_notes_sync_purge size=34
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=purge
  @0x0002   32        u8         id  big

struct fzn_notes_sync_purge_ack size=35
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=purge_ack
  @0x0002   32        u8         id  big
  @0x0022   1         u8         erased  max=1

struct fzn_notes_sync_purges size=3..515
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=purges
  @0x0002   1         u8         count  max=16
  @0x0003   0..512    fzn_notes_sync_note_id ids  sized-by=count

struct fzn_notes_sync_purges_query size=2
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=purges_query

struct fzn_notes_sync_record size=3..670
  @0x0000   2         u16        len  big min=1 max=668
  @0x0002   1..668    u8         record  sized-by=len

struct fzn_notes_sync_records size=3..10723
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=records
  @0x0002   1         u8         count  max=16
  @0x0003   0..10720  fzn_notes_sync_record records  sized-by=count

struct fzn_notes_sync_records_query size=35..515
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=records_query
  @0x0002   1         u8         count  min=1 max=16
  @0x0003   32..512   fzn_notes_sync_key keys  big sized-by=count

struct fzn_notes_sync_text_push size=42..
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=text_push
  @0x0002   32        u8         root  big
  @0x0022   8         u64        length  big
  @0x002a   0..       u8         data  sized-by=remaining

struct fzn_notes_sync_text_pushed size=3
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=text_pushed
  @0x0002   1         u8         outcome  max=2

struct fzn_notes_sync_wrap size=64
  @0x0000   32        u8         id  big
  @0x0020   32        u8         key  big

struct fzn_notes_sync_wraps size=3..1027
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=wraps
  @0x0002   1         u8         count  max=16
  @0x0003   0..1024   fzn_notes_sync_wrap keys  sized-by=count

struct fzn_notes_sync_wraps_query size=3..515
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=wraps_query
  @0x0002   1         u8         count  max=16
  @0x0003   0..512    fzn_notes_sync_note_id ids  sized-by=count

struct fzn_notes_sync_writer size=32
  @0x0000   32        u8         key  big

struct fzn_notes_sync_writers size=3..2051
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=writers
  @0x0002   1         u8         count  max=64
  @0x0003   0..2048   fzn_notes_sync_writer writers  sized-by=count

struct fzn_notes_sync_writers_query size=2
  @0x0000   1         u8         version  must_eq=2
  @0x0001   1         fzn_notes_sync_type type  must_eq=writers_query
