// The catalogue object bodies as situ schemas -- converted from hand-written
// C (catalog/catalog.h, catalog/catalog.c) the way record/record.situ was.
//
// These are RECORD BODIES sharing a 1-byte object tag at offset 0, dispatched
// by fzn_catalog_apply on body[0]. Each is its own top-level struct here
// because they are separate assertions with separate sequences, not arms of
// one wire object. Measured against the committed FZN_CATALOG_* constants.
//
// FZN_CATALOG_ID_LEN = 32. FZN_CATALOG_CONTENT_HEAD_LEN = 34 (object + id +
// one tag byte) is shared by content and name; the byte at offset 33 is the
// content `kind` in a content body and the name length in a name body.

target buffer;
endian big;

// -------------------------------------------------------------------------
// EDGE -- fixed, 66 bytes (FZN_CATALOG_EDGE_BODY_LEN). A membership assertion:
// `child` is (present=1) or is not (present=0) a member of `parent`.
//   [0]        FZN_CATALOG_OBJECT_EDGE (1)
//   [1..33)    parent
//   [33..65)   child
//   [65]       present, exactly 0 or 1
struct fzn_catalog_edge {
	u8  object [must_eq = 1];  // offset 0   (FZN_CATALOG_OBJECT_EDGE)
	u8  parent[32];          // offset 1   (FZN_CATALOG_ID_LEN)
	u8  child[32];           // offset 33
	u8  present [max = 1];   // offset 65  (exactly 0 or 1)
}

// -------------------------------------------------------------------------
// CONTENT -- variable, 34 bytes plus what the kind needs
// (FZN_CATALOG_CONTENT_HEAD_LEN = 34). One assertion about a node's content
// with three possible answers, dispatched on the kind byte at offset 33:
//   [0]        FZN_CATALOG_OBJECT_CONTENT (2)
//   [1..33)    id
//   [33]       kind
//   NONE       nothing more; 34 bytes total
//   INLINE     the value bytes; 34 + len
//   BLOB       [34..66) root, [66..74) length; 74 bytes (FZN_CATALOG_BLOB_BODY_LEN)
enum fzn_catalog_content_kind : u8 {
	none   = 0,              // FZN_CATALOG_CONTENT_NONE
	inline_value = 1,        // FZN_CATALOG_CONTENT_INLINE
	blob   = 2,              // FZN_CATALOG_CONTENT_BLOB
}

// The BLOB tail: a digest naming content in spool/, and its length.
struct fzn_catalog_blob {
	u8  root[32];            // offset 34  (FZN_BLOB_HASH_LEN)
	u64 length;              // offset 66
}

// The NONE tail: zero bytes.
struct fzn_catalog_content_none {
}

struct fzn_catalog_content {
	u8  object [must_eq = 2];            // offset 0   (FZN_CATALOG_OBJECT_CONTENT)
	u8  id[32];                          // offset 1   (FZN_CATALOG_ID_LEN)
	fzn_catalog_content_kind kind;       // offset 33  (FZN_CATALOG_CONTENT_HEAD_LEN - 1)
	variant tail switch (kind) {
		case fzn_catalog_content_kind.none:   fzn_catalog_content_none  empty;   // offset 34
		case fzn_catalog_content_kind.inline_value: u8 value[remaining];             // offset 34
		case fzn_catalog_content_kind.blob:   fzn_catalog_blob  ref;             // offset 34
	}
}

// -------------------------------------------------------------------------
// NAME -- variable, 34 bytes plus the name text. A name assertion; the byte at
// offset 33 is the text length (0..FZN_CATALOG_NAME_MAX = 255), which is why
// the head length is shared with content (FZN_CATALOG_CONTENT_HEAD_LEN = 34).
//   [0]        FZN_CATALOG_OBJECT_NAME (3)
//   [1..33)    id
//   [33]       len
//   [34..]     text (len bytes)
// This is frame.situ's exact form: a prior length field sizing the array.
struct fzn_catalog_name {
	u8  object [must_eq = 3];  // offset 0   (FZN_CATALOG_OBJECT_NAME)
	u8  id[32];              // offset 1   (FZN_CATALOG_ID_LEN)
	u8  len [max = 255];     // offset 33  (FZN_CATALOG_CONTENT_HEAD_LEN - 1; FZN_CATALOG_NAME_MAX)
	u8  text[len];           // offset 34  (FZN_CATALOG_CONTENT_HEAD_LEN)
}
