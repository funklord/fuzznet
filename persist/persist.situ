// The persist blobs as a situ schema, converted from the hand-written layout
// in persist/persist.c. These are ON-DISK blobs a backend stores and returns,
// so the target is `file`: per the grammar (doc/decision/0047), `target file`
// sets effect = EffectOnWrite on every member, which is the on-write discipline
// an at-rest record wants, where `target buffer` is for bytes already in hand.
//
// Every blob is `version | tag | body` (persist.c: OFF_VERSION=0, OFF_TAG=1,
// OFF_BODY=2), a two-byte head followed by ONE OF the bodies below, chosen by
// the tag: most fixed, those carrying a chain sized by their hop counts, and
// a note's sized by the record it holds. It is a TAGGED UNION, modelled with
// situ's variant/switch: the tag is the discriminant and each arm is one body
// struct.
//
// The tag byte is checked exactly by persist.c's head_check, and an unknown
// tag is refused (FZN_PERSIST_ERR_SHAPE) rather than reinterpreted -- so the
// enum carries `default = error`, and the variant's `default: error` refuses
// an unknown tag rather than reading the body as something it is not.
//
// Big-endian: persist.c writes every multi-byte integer with fzn_put_be64.
//
// Body lengths, from persist.c (asserted there against FZN_PERSIST_MAX = 96):
//   FZN_PUBKEY_LEN = 32, FZN_AGREE_SECRET_LEN = 32, FZN_PREKEY_LEN = 32,
//   FZN_CHAIN_KEY_LEN = 32.
//   TRUST_BODY  = 32 + 1 + 8 = 41   (root, source, adopted_at)
//   SECRET_BODY = 32 + 8      = 40   (secret, generation)
//   PEER_BODY   = 41 + 32 + 8 = 81   (trust, prekey, created_at)
//   CHAIN_BODY  = 32 + 8      = 40   (key, seq)
//   IDENTITY_BODY = 32             (seed; FZN_SIGN_SEED_LEN, sec 375)
//   PAIRING_BODY  = 32+32+32+32+1 + 179 * hop_count = 308..1561
//                                  (node, capability, send_key, send_ckey,
//                                  hop_count, chain; node/pair.c, secs 377, 391)
//   REVOCATION_BODY = 210          (a signed revocation record,
//                                  chain/revocation.situ; node/revoke.c, sec 380;
//                                  202 until the epoch, sec 400)
//   VOTE_BODY = 210 + 1 + 179 * hop_count = 211..1464
//                                  (record, hop_count, chain; node/revoke.c,
//                                  sec 399)
//   NODE_PEER_BODY = 32+32+32+1 + 179 * hop_count = 97..1529
//                                  (sender, recv_key, recv_ckey, hop_count,
//                                  hops; node/peer_persist.c, sec 366)

target file;
endian big;

// persist.c: BLOB_TRUST=1, BLOB_SECRET=2, BLOB_PEER=3, BLOB_CHAIN=4,
// BLOB_IDENTITY=6, FZN_PERSIST_BLOB_PAIRING=7, which node/pair.c packs, and
// FZN_PERSIST_BLOB_REVOCATION=8 and FZN_PERSIST_BLOB_VOTE=9, which
// node/revoke.c packs.
// A byte that is not one of these is refused, matching head_check's tag
// mismatch. 5 is FZN_PERSIST_BLOB_NODE_PEER, which node/peer_persist.c packs
// with a body sized by its hop count; described since sec 387.
enum fzn_persist_tag : u8 {
	trust  = 1,
	secret = 2,
	peer   = 3,
	chain  = 4,
	node_peer = 5,
	identity = 6,
	pairing = 7,
	revocation = 8,
	vote = 9,
	root_entry = 10,
	root_add = 11,
	root_remove = 12,
	own_root = 13,
	admin_confirm = 14,
	own_admin = 15,
	quorum_set = 16,
	note = 17,
	note_seq = 18,
	note_purge = 19,
	note_partner = 20,
	contact = 21,
	note_share = 22,
	shared_note = 23,
	received_share = 24,
	contact_group = 25,
	log_rule = 26,
	default = error,
}

// A trust anchor: its root key, how it arrived, and when it was adopted.
// TRUST_BODY = 41.
struct fzn_persist_trust_body {
	u8  root[32];
	u8  source;
	u64 adopted_at;
}

// The host's own prekey secret and its generation. The public half is derived
// on restore and is NOT stored (persist.c). SECRET_BODY = 40.
struct fzn_persist_secret_body {
	u8  secret[32];
	u64 generation;
}

// A pinned peer: its trust anchor (packed through the trust body, its two-byte
// head dropped, so there is ONE encoding of a trust), its prekey, and when the
// prekey was created. PEER_BODY = 81.
struct fzn_persist_peer_body {
	fzn_persist_trust_body trust;
	u8  prekey[32];
	u64 created_at;
}

// A ratchet chain: its key and sequence number. Tagged as a chain and not as a
// direction -- a send chain and a receive chain are the same bytes (persist.c).
// CHAIN_BODY = 40.
struct fzn_persist_chain_body {
	u8  key[32];
	u64 seq;
}

// The seed this host's signing key derives from, stored as it is and never
// all zero (persist.c refuses that both ways). IDENTITY_BODY = 32.
struct fzn_persist_identity_body {
	u8  seed[32];
}

// A device's pairing to one node: the node, the capability it was granted,
// the session keys it seals with, and its grant as the whole chain from the
// estate's root, as the card carried it (sec 391). The hops are opaque here,
// as the node peer's are. PAIRING_BODY = 308..1561.
struct fzn_persist_pairing_body {
	u8  node[32];
	u8  capability[32];
	u8  send_key[32];
	u8  send_ckey[32];
	u8  hop_count [min = 1, max = 8];
	fzn_persist_hop chain[hop_count];
}

// A revocation this node issued, as the signed record it minted (210 bytes,
// chain/revocation.situ -- kept opaque here, as the pairing's hop is).
// REVOCATION_BODY = 210.
struct fzn_persist_revocation_body {
	u8  record[210];
}

// One signed hop, opaque here as the pairing's is (179 bytes,
// chain/hop.situ). A struct so the node peer's hops can be counted.
struct fzn_persist_hop {
	u8  bytes[179];
}

// A vote this node learned from a peer, with the chain that entitles its
// issuer (sec 399): none for the root's, and at most seven, since an offered
// chain may carry FZN_CHAIN_MAX_HOPS - 1 hops and node/revoke.c refuses more.
struct fzn_persist_vote_body {
	u8  record[210];
	u8  hop_count [max = 7];
	fzn_persist_hop hops[hop_count];
}

// A root log entry, a root-add and a root-remove, as node/roots.c keeps
// them (sec 407): each the signed record whole, opaque here, laid out in
// chain/root_act.situ.
struct fzn_persist_root_entry_body {
	u8  record[171];
}

struct fzn_persist_root_add_body {
	u8  record[130];
}

struct fzn_persist_root_remove_body {
	u8  record[162];
}

// A root's setting of the estate's k (sec 418), laid out in chain/root_log.h.
struct fzn_persist_quorum_set_body {
	u8  record[131];
}

// The seed of the root key a node holds beside its identity (sec 409),
// never all zero, as the identity seed is.
struct fzn_persist_own_root_body {
	u8  seed[32];
}

// An admin confirmation (sec 415), laid out in chain/revocation.situ and
// opaque here, with the confirmer's admin chain: none for a root's, and at
// most seven, as for a vote.
struct fzn_persist_admin_confirm_body {
	u8  record[130];
	u8  hop_count [max = 7];
	fzn_persist_hop hops[hop_count];
}

// This node's own admin chain (sec 416): from a root to its identity for
// the admin capability, at most seven hops, as for a vote's chain.
struct fzn_persist_own_admin_body {
	u8  hop_count [min = 1, max = 7];
	fzn_persist_hop hops[hop_count];
}

// A peer as the NODE keeps it: who it is, the session keys its frames open
// under, and its grant as the whole chain from the root -- one hop when the
// node minted it, more when the node grants through an estate's chain (sec
// 383). hop_count is refused past FZN_CHAIN_MAX_HOPS by peer_persist.c's
// open, and at zero there is nothing to authorise with.
struct fzn_persist_node_peer_body {
	u8  sender[32];
	u8  recv_key[32];                // FZN_AEAD_KEY_LEN
	u8  recv_ckey[32];               // FZN_COMMITMENT_KEY_LEN
	u8  hop_count [max = 8];         // FZN_CHAIN_MAX_HOPS
	fzn_persist_hop hops[hop_count];
}

// One writer's latest signed record about one note: a record as
// record/record.situ lays it out, whole, to the end of the blob. Its own
// body_len says where its signature starts; notes/store.c opens it with
// fzn_record_open and refuses a trailing byte. sec 425.
struct fzn_persist_note_body {
	u8  record[remaining];
}

// The last sequence this host signed a note record at. sec 425.
struct fzn_persist_note_seq_body {
	u64 seq;
}

// One host pinned to sign off a purge, and whether it has. sec 427.
struct fzn_persist_purge_host {
	u8  host[32];
	u8  answered [max = 1];
}

// A purge awaiting consensus: when it was queued, when its hosts were last
// asked, and the set pinned at queue time, deduplicated, at most
// FZN_NOTES_PURGE_ASK_MAX = 32. notes/purge.c, sec 427.
struct fzn_persist_note_purge_body {
	u64 queued_at;
	u64 last_push;
	u8  asked_count [max = 32];
	fzn_persist_purge_host asked[asked_count];
}

// A node that pulls notes from this one: when it last did. notes/sync.c,
// sec 433.
struct fzn_persist_note_partner_body {
	u64 last_pull;
}

// A contact: a key outside the estate, by a name of 1 to 32 characters of
// [A-Za-z0-9_], fuzzypickles' rule for a peer name. The key is the persist
// subject. contact/contact.c, sec 435.
struct fzn_persist_contact_body {
	u8  name_len [min = 1, max = 32];
	u8  name[name_len];
	u64 added_at;
}

// A subtree of notes shared with a contact: the subtree's root note, the
// contact's key, and when it was shared. notes/share.c, sec 436.
struct fzn_persist_note_share_body {
	u8  subtree[32];
	u8  contact[32];
	u64 shared_at;
}

// A note a contact shared with this node, in that sharer's tree: the
// sharer, the claim key notes/store.c would file it under, and the record
// whole, as fzn_persist_note_body holds it. Filed under a hash of the two
// keys. notes/received.c, sec 437.
struct fzn_persist_shared_note_body {
	u8  sharer[32];
	u8  claim[32];
	u8  record[remaining];
}

// A share this node accepted: where the sharer's node is pulled from, a
// host of 1 to 253 bytes from 0x21 to 0x7e and a port that is not 0. The
// sharer's node key is the persist subject. node/received.c, sec 437.
struct fzn_persist_received_share_body {
	u8  host_len [min = 1, max = 253];
	u8  host[host_len];
	u16 port [min = 1];
	u64 accepted_at;
}

// A group of contacts: its name, as a contact name, and its members' keys.
// Filed under its id, a hash of its name. contact/group.c, sec 471.
struct fzn_persist_group_member {
	u8  key[32];
}

struct fzn_persist_contact_group_body {
	u8  name_len [min = 1, max = 32];
	u8  name[name_len];
	u8  count [max = 64];
	fzn_persist_group_member members[count];
	u64 made_at;
}

// A retention rule set while the node runs: its canonical text, 1 to 255
// bytes, and when it was added. Filed under a hash of the text.
// log/rules.c, sec 475.
struct fzn_persist_log_rule_body {
	u8  text_len [min = 1, max = 255];
	u8  text[text_len];
	u64 added_at;
}

// version | tag | body. The body is the arm the tag selects.
struct fzn_persist_blob {
	u8               version;
	fzn_persist_tag  tag;

	variant body switch (tag) {
		case fzn_persist_tag.trust:  fzn_persist_trust_body   trust;
		case fzn_persist_tag.secret: fzn_persist_secret_body  secret;
		case fzn_persist_tag.peer:   fzn_persist_peer_body    peer;
		case fzn_persist_tag.chain:  fzn_persist_chain_body   chain;
		case fzn_persist_tag.node_peer: fzn_persist_node_peer_body node_peer;
		case fzn_persist_tag.identity: fzn_persist_identity_body identity;
		case fzn_persist_tag.pairing:  fzn_persist_pairing_body  pairing;
		case fzn_persist_tag.revocation: fzn_persist_revocation_body revocation;
		case fzn_persist_tag.vote: fzn_persist_vote_body vote;
		case fzn_persist_tag.root_entry: fzn_persist_root_entry_body root_entry;
		case fzn_persist_tag.root_add: fzn_persist_root_add_body root_add;
		case fzn_persist_tag.root_remove: fzn_persist_root_remove_body root_remove;
		case fzn_persist_tag.own_root: fzn_persist_own_root_body own_root;
		case fzn_persist_tag.admin_confirm: fzn_persist_admin_confirm_body admin_confirm;
		case fzn_persist_tag.own_admin: fzn_persist_own_admin_body own_admin;
		case fzn_persist_tag.quorum_set: fzn_persist_quorum_set_body quorum_set;
		case fzn_persist_tag.note: fzn_persist_note_body note;
		case fzn_persist_tag.note_seq: fzn_persist_note_seq_body note_seq;
		case fzn_persist_tag.note_purge: fzn_persist_note_purge_body note_purge;
		case fzn_persist_tag.note_partner: fzn_persist_note_partner_body note_partner;
		case fzn_persist_tag.contact: fzn_persist_contact_body contact;
		case fzn_persist_tag.note_share: fzn_persist_note_share_body note_share;
		case fzn_persist_tag.shared_note: fzn_persist_shared_note_body shared_note;
		case fzn_persist_tag.received_share: fzn_persist_received_share_body received_share;
		case fzn_persist_tag.contact_group: fzn_persist_contact_group_body contact_group;
		case fzn_persist_tag.log_rule: fzn_persist_log_rule_body log_rule;
		default: error;
	}
}
