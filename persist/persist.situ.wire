# situ wire signature v2
# schema: persist.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target file

enum fzn_persist_tag : u8 unknown=error
  trust=1 secret=2 peer=3 chain=4 node_peer=5 identity=6 pairing=7 revocation=8 vote=9 root_entry=10 root_add=11 root_remove=12 own_root=13 admin_confirm=14 own_admin=15 quorum_set=16

struct fzn_persist_admin_confirm_body size=131..1384
  @0x0000   130       u8         record  big
  @0x0082   1         u8         hop_count  max=7
  @0x0083   0..1253   fzn_persist_hop hops  sized-by=hop_count

struct fzn_persist_blob size=34..1563
  @0x0000   1         u8         version
  @0x0001   1         fzn_persist_tag tag
  @0x0002   32..1561  variant    body
  body switch: tag
  body case 1: trust fzn_persist_trust_body
  body case 2: secret fzn_persist_secret_body
  body case 3: peer fzn_persist_peer_body
  body case 4: chain fzn_persist_chain_body
  body case 5: node_peer fzn_persist_node_peer_body
  body case 6: identity fzn_persist_identity_body
  body case 7: pairing fzn_persist_pairing_body
  body case 8: revocation fzn_persist_revocation_body
  body case 9: vote fzn_persist_vote_body
  body case 10: root_entry fzn_persist_root_entry_body
  body case 11: root_add fzn_persist_root_add_body
  body case 12: root_remove fzn_persist_root_remove_body
  body case 13: own_root fzn_persist_own_root_body
  body case 14: admin_confirm fzn_persist_admin_confirm_body
  body case 15: own_admin fzn_persist_own_admin_body
  body case 16: quorum_set fzn_persist_quorum_set_body
  body case default: error

struct fzn_persist_chain_body size=40
  @0x0000   32        u8         key  big
  @0x0020   8         u64        seq  big

struct fzn_persist_hop size=179
  @0x0000   179       u8         bytes  big

struct fzn_persist_identity_body size=32
  @0x0000   32        u8         seed  big

struct fzn_persist_node_peer_body size=97..1529
  @0x0000   32        u8         sender  big
  @0x0020   32        u8         recv_key  big
  @0x0040   32        u8         recv_ckey  big
  @0x0060   1         u8         hop_count  max=8
  @0x0061   0..1432   fzn_persist_hop hops  sized-by=hop_count

struct fzn_persist_own_admin_body size=180..1254
  @0x0000   1         u8         hop_count  min=1 max=7
  @0x0001   179..1253 fzn_persist_hop hops  big sized-by=hop_count

struct fzn_persist_own_root_body size=32
  @0x0000   32        u8         seed  big

struct fzn_persist_pairing_body size=308..1561
  @0x0000   32        u8         node  big
  @0x0020   32        u8         capability  big
  @0x0040   32        u8         send_key  big
  @0x0060   32        u8         send_ckey  big
  @0x0080   1         u8         hop_count  min=1 max=8
  @0x0081   179..1432 fzn_persist_hop chain  big sized-by=hop_count

struct fzn_persist_peer_body size=81
  @0x0000   41        fzn_persist_trust_body trust  big
  @0x0029   32        u8         prekey  big
  @0x0049   8         u64        created_at  big

struct fzn_persist_quorum_set_body size=131
  @0x0000   131       u8         record  big

struct fzn_persist_revocation_body size=210
  @0x0000   210       u8         record  big

struct fzn_persist_root_add_body size=130
  @0x0000   130       u8         record  big

struct fzn_persist_root_entry_body size=171
  @0x0000   171       u8         record  big

struct fzn_persist_root_remove_body size=162
  @0x0000   162       u8         record  big

struct fzn_persist_secret_body size=40
