// This user's groups, asked in binary on the local leg: project.md sec
// 1170, the next category by fuzzypickles' measure (sec 1155) -- the
// conversation list asks for the groups on every refresh, beside every
// conversation's newest line and count.
//
// FZN_CMD_GROUPS (13, wire/cmd.h), its operation the SUBCMD, in the range
// 128 to 191 kept for the local socket; between hosts the category's
// SUBCMDs are below it. A request is one message with no body; the answer
// is a row per group this user is in and then a STATUS ok, or a STATUS
// refusing it -- each framed as the local leg frames a message (sec 1113).

target buffer;
endian big;

enum op : u8 {
	list       = 128, // every group this user is in, as `list group` lists them
	row        = 129, // an answer: one group
	members    = 130, // one group's roster, by its id (sec 1179)
	member_row = 131, // an answer: one member
	default    = error,
}

struct nothing {
}

// ID the group's, what a client keys on (sec 647); NAME this host's for it,
// or its id's first eight bytes in hex where it has none; MEMBERS how many;
// ADMIN 1 when this user may change it (sec 927); LINES how many of its
// lines are held, unchanged meaning nothing new to read.
struct row {
	u8   id[32];
	u32  members;
	u8   admin [max = 1];
	u64  lines;
	u8   name_len [max = 32];
	u8   name[name_len];
}

// ID the group's.
struct members_ask {
	u8   id[32];
}

// KEY the member's root key; ADMIN 1 when the roster marks it an admin;
// NAME this user's contact name for it, empty for a member who is no
// contact here.
struct member_row {
	u8   key[32];
	u8   admin [max = 1];
	u8   name_len [max = 32];
	u8   name[name_len];
}

struct message {
	u8   cmd [must_eq = 13];
	op   op;

	variant body switch (op) {
		case op.list:       nothing     list;
		case op.row:        row         row;
		case op.members:    members_ask members;
		case op.member_row: member_row  member_row;
		default: error;
	}
}
