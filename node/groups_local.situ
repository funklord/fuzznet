// This user's groups, asked in binary on the local leg: project.md sec
// 1170, the next category by fuzzypickles' measure (sec 1155) -- the
// conversation list asks for the groups on every refresh, beside every
// conversation's newest line and count.
//
// FZN_CMD_GROUPS (13, wire/cmd.h), its operation the SUBCMD, in the range
// 128 to 191 kept for the local socket; between hosts the category's
// SUBCMDs are below it. A request is one message with no body; the answer
// is a row per group this user is in and then a STATUS ok, or a STATUS
// refusing it -- each framed as the local leg frames a message (sec 1113).

target buffer;
endian big;

enum op : u8 {
	list       = 128, // every group this user is in, as `list group` lists them
	row        = 129, // an answer: one group
	members    = 130, // one group's roster, by its id (sec 1179)
	member_row = 131, // an answer: one member
	change     = 132, // a group made, left, its members or admins changed (sec 1222)
	created    = 133, // an answer: the group made's id
	proposed   = 134, // an answer: an admin's change waiting on the others
	backfill   = 135, // whether a later member gets what came before, asked
	backfill_row = 136, // an answer: it, 0 or 1
	default    = error,
}

struct nothing {
}

// ID the group's, what a client keys on (sec 647); NAME this host's for it,
// or its id's first eight bytes in hex where it has none; MEMBERS how many;
// ADMIN 1 when this user may change it (sec 927); LINES how many of its
// lines are held, unchanged meaning nothing new to read.
struct row {
	u8   id[32];
	u32  members;
	u8   admin [max = 1];
	u64  lines;
	u8   name_len [max = 32];
	u8   name[name_len];
}

// ID the group's.
// WHAT IS CHANGED of the group named GROUP, as its verb says it: 1 made
// (`add group`, answered `created`), 2 left (`remove group`), 3 and 4 the
// contact named WHO added or removed as a member, 5 and 6 made or unmade
// an admin (answered `proposed` while other admins must agree), 7 and 8 a
// later member to get what came before or not (`set group GROUP backfill`).
// Then a STATUS: ok, or the verb's refusal in its words.
enum what : u8 {
	create         = 1,
	leave          = 2,
	member_add     = 3,
	member_remove  = 4,
	admin_add      = 5,
	admin_remove   = 6,
	backfill_on    = 7,
	backfill_off   = 8,
	default        = error,
}

struct change {
	what what;
	u8   group_len [min = 1, max = 64];
	u8   group[group_len];
	u8   who_len [max = 64];
	u8   who[who_len];
}

struct created {
	u8   id[32];
}

// APPROVALS so far of the NEEDED, sec 1012.
struct proposed {
	u16  approvals;
	u16  needed;
}

struct backfill_ask {
	u8   group_len [min = 1, max = 64];
	u8   group[group_len];
}

struct backfill_row {
	u8   on [max = 1];
}

struct members_ask {
	u8   id[32];
}

// KEY the member's root key; ADMIN 1 when the roster marks it an admin;
// NAME this user's contact name for it, empty for a member who is no
// contact here.
struct member_row {
	u8   key[32];
	u8   admin [max = 1];
	u8   name_len [max = 32];
	u8   name[name_len];
}

struct message {
	u8   cmd [must_eq = 13];
	op   op;

	variant body switch (op) {
		case op.list:       nothing     list;
		case op.row:        row         row;
		case op.members:    members_ask members;
		case op.member_row: member_row  member_row;
		case op.change:     change       change;
		case op.created:    created      created;
		case op.proposed:   proposed     proposed;
		case op.backfill:   backfill_ask backfill;
		case op.backfill_row: backfill_row backfill_row;
		default: error;
	}
}
