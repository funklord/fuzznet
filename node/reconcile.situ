// Reconciliation's messages: what one node holds of the estate's state, and
// the objects another lacks. project.md sec 551. The hand-written codec is
// node/reconcile.c; this is its checked contract, in `make schema`'s list.
//
// The first byte is the message version, 6, below any verb's first letter
// and apart from notes and messages (2), cause (3), gather (4) and the
// journal's exchange (5), so a node dispatching on it falls through.

target buffer;
endian big;

enum fzn_reconcile_type : u8 {
	digest_query  = 1,   // "What do you hold?"
	digest        = 2,   // "Of each class, this many, digested so."
	ids_query     = 3,   // "That class's ids, from this one."
	ids           = 4,   // "These, of this many."
	objects_query = 5,   // "These objects, by id."
	objects       = 6,   // "Those I hold of them."
	base_query    = 7,   // "Where does this stream start with you?" sec 552.
	base          = 8,   // "There, under this id, and the spine to it."
	buckets_query = 9,   // "Your buckets of this kind, from this one." sec 564.
	buckets       = 10,  // "These, of this many."
	bucket_ids_query = 11, // "That bucket's ids, from this one."
	bucket_ids    = 12,  // "These, of this many."
	item_query    = 13,  // "That item's bytes, from this offset."
	item          = 14,  // "Of so many, these." 0 of 0: not held here.
	item_put      = 15,  // "Take this item, these bytes of it." sec 569.
	item_took     = 16,  // "Of it I hold so much -- or kept it, or will not."
}

// What a receiver says of an item pushed to it, sec 569.
enum fzn_reconcile_took : u8 {
	more         = 0,   // send on from `held`
	kept         = 1,   // whole, checked and filed
	held         = 2,   // held already; send no more of it
	refused      = 3,   // not its id's, or its kind's filer refused it
	not_wanted   = 4,   // a bucket gone here, or one its rules would not hold
}

struct fzn_reconcile_digest_query {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = digest_query];
}

// One class: node/holdings.h's fzn_holdings_class_t, its count, its digest.
// A class past this build's is a newer peer's, and is passed over.
struct fzn_reconcile_class {
	u8   class   [max = 8];
	u32  count;
	u8   digest[32];
}

struct fzn_reconcile_digest {
	u8                   version [must_eq = 6];
	fzn_reconcile_type   type    [must_eq = digest];
	u8                   count   [max = 9];
	fzn_reconcile_class  classes[count];
}

struct fzn_reconcile_ids_query {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = ids_query];
	u8                  class   [max = 8];
	u32                 from;               // the first id wanted, by position
}

struct fzn_reconcile_id {
	u8  id[32];
}

struct fzn_reconcile_ids {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = ids];
	u8                  class   [max = 8];
	u32                 total;              // every id of the class held
	u32                 from;               // echoed
	u16                 count;
	fzn_reconcile_id    ids[count];         // ascending
}

struct fzn_reconcile_objects_query {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = objects_query];
	u8                  class   [max = 8];
	u8                  count   [min = 1, max = 32];
	fzn_reconcile_id    ids[count];
}

// One signed object, whole: a hop, a root record, a vote, a confirmation,
// a retention record, a roster record, a succession, a setting, or a note
// record (sec 555).
struct fzn_reconcile_object {
	u16  len [min = 3, max = 2048];
	u8   object[len];
}

struct fzn_reconcile_base_query {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = base_query];
	u8                  issuer[32];
	u32                 stream;
	u64                 from    [min = 1];  // the first spine entry wanted
}

// A spine entry: a record's id, its predecessor's, and its subject.
struct fzn_reconcile_spine_entry {
	u8  id[32];
	u8  prev[32];
	u8  subject[32];
}

struct fzn_reconcile_base {
	u8                         version [must_eq = 6];
	fzn_reconcile_type         type    [must_eq = base];
	u64                        base    [min = 1];  // the first sequence held
	u8                         below[32];          // the id of the record before it
	u64                        from;               // echoed
	u16                        count;
	fzn_reconcile_spine_entry  entries[count];     // from `from`, ascending
}

struct fzn_reconcile_objects {
	u8                    version [must_eq = 6];
	fzn_reconcile_type    type    [must_eq = objects];
	u8                    class   [max = 8];
	u16                   count;
	fzn_reconcile_object  objects[count];
}

// ---- append-only kinds, by bucket: node/buckets.h, sec 564 ----------------

struct fzn_reconcile_buckets_query {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = buckets_query];
	u8                  kind    [max = 0];  // node/buckets.situ's fzn_buckets_kind
	u32                 from;               // the first bucket wanted, by position
}

// One bucket: whose, which month, how many items, digested so.
struct fzn_reconcile_bucket {
	u8   subject[32];
	u32  month;
	u64  count;
	u8   digest[32];
}

struct fzn_reconcile_buckets {
	u8                    version [must_eq = 6];
	fzn_reconcile_type    type    [must_eq = buckets];
	u8                    kind    [max = 0];
	u32                   total;            // every bucket of the kind held
	u32                   from;             // echoed
	u16                   count;
	fzn_reconcile_bucket  buckets[count];   // ascending by subject, then month
}

struct fzn_reconcile_bucket_ids_query {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = bucket_ids_query];
	u8                  kind    [max = 0];
	u8                  subject[32];
	u32                 month;
	u32                 from;
}

struct fzn_reconcile_bucket_ids {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = bucket_ids];
	u8                  kind    [max = 0];
	u8                  subject[32];
	u32                 month;
	u32                 total;
	u32                 from;               // echoed
	u16                 count;
	fzn_reconcile_id    ids[count];         // in the order they were taken there
}

struct fzn_reconcile_item_query {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = item_query];
	u8                  kind    [max = 0];
	u8                  id[32];
	u32                 offset;
}

struct fzn_reconcile_item {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = item];
	u8                  kind    [max = 0];
	u8                  id[32];
	u32                 total   [max = 4096]; // the item's length; 0, not held
	u32                 offset;             // echoed
	u16                 len;
	u8                  bytes[len];
}

// ---- push, sec 569: the same items, sent rather than fetched -------------

struct fzn_reconcile_item_put {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = item_put];
	u8                  kind    [max = 0];
	u8                  subject[32];
	u32                 month;
	u8                  id[32];
	u32                 total   [min = 1, max = 4096]; // the item's length
	u32                 offset;             // where these bytes start
	u16                 len;
	u8                  bytes[len];
}

struct fzn_reconcile_item_took {
	u8                  version [must_eq = 6];
	fzn_reconcile_type  type    [must_eq = item_took];
	u8                  kind    [max = 0];
	u8                  id[32];
	fzn_reconcile_took  took;
	u32                 held;               // bytes held of it, for `more`
}
