# situ wire signature v4
# schema: contacts_local.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum op : u8 unknown=error
  list=128 row=129 add=130 remove=131 clash=132 requests=133 request_row=134 grant=135 refuse=136

enum standing : u8 unknown=error
  active=0 suspended=1 retired=2 absent=3

struct add size=33..65
  @0x0000   32        u8         key  big
  @0x0020   1         u8         name_len  max=32
  @0x0021   0..32     u8         name  sized-by=name_len

struct keyed size=32
  @0x0000   32        u8         key  big

struct message size=2..140
  @0x0000   1         u8         cmd  must_eq=11
  @0x0001   1         op         op
  @0x0002   0..138    variant    body
  body switch: op
  body case 128: list nothing
  body case 129: row row
  body case 130: add add
  body case 131: remove keyed
  body case 132: clash keyed
  body case 133: requests nothing
  body case 134: request_row request_row
  body case 135: grant add
  body case 136: refuse keyed
  body case default: error

struct nothing size=0

struct request_row size=42..138
  @0x0000   32        u8         key  big
  @0x0020   8         u64        received_ms  big
  @0x0028   1         u8         name_len  max=32
  @0x0029   0..32     u8         name  sized-by=name_len
  ~         1         u8         where_len  max=64
  ~         0..64     u8         where  sized-by=where_len

struct row size=34..66
  @0x0000   32        u8         key  big
  @0x0020   1         standing   standing
  @0x0021   1         u8         name_len  max=32
  @0x0022   0..32     u8         name  sized-by=name_len
