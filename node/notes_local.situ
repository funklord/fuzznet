// The notes under one parent, asked in binary on the local leg: project.md
// sec 1191, what a notebook lists each time it opens a folder -- this
// user's own tree, or the one a contact shared with this node (sec 437).
//
// FZN_CMD_NOTES (8, wire/cmd.h): notes are this category's, so its local
// operations are in the range 128 to 191 kept for the local socket;
// between hosts its sync takes the SUBCMDs below. A request is one
// message; the answer is a row per note, in the tree's order, and then a
// STATUS ok, or a STATUS refusing it.

target buffer;
endian big;

enum op : u8 {
	notes    = 128, // the notes under a parent, as `list note` lists them
	note_row = 129, // an answer: one note
	stamp    = 130, // whether anything moved, as `get notes` says (sec 1199)
	stamp_row = 131, // an answer: the stamp
	shares   = 132, // where this user's notes go, as `list share` (sec 1200)
	share_row = 133, // an answer: one share
	note     = 134, // one note, whole, as `get note ID` and its fields say (sec 1201)
	note_fields = 135, // an answer: the note's fields, meta and reference
	note_text = 136, // an answer: a piece of the note's text
	add      = 137, // a note, folder or checklist made, as `add note` (sec 1218)
	added    = 138, // an answer: its id
	change   = 139, // one field of a note changed, as `set note ID FIELD` (sec 1218)
	item     = 140, // a checklist's item added, ticked or removed (sec 1218)
	text     = 141, // a piece of a note's new text (sec 1219)
	share    = 142, // a note shared, or no longer, as `add|remove share` (sec 1220)
	trash_empty = 143, // the trash emptied, as `remove note trash` (sec 1220)
	trash_emptied = 144, // an answer: what was queued, and what waits
	attach   = 145, // a file attached in a folder, as `add attachment` (sec 1220)
	default  = error,
}

struct nothing {
}

// STAMP a number that moves with every write the notes could be in, 0
// where none is kept (sec 1006): a view refreshed on a timer reads a
// folder only when it moved.
struct stamp_row {
	u64  stamp;
}

// SHARER and ID: the note asked, in this user's own notes for a zero
// SHARER, else in the tree that key shared with this node.
struct note_ask {
	u8   sharer[32];
	u8   id[32];
}

// THE NOTE, as `get note ID` says it, its meta and an attachment's
// reference, in one row. CONTENT_TYPE, FLAGS, CREATED_MS and EDITED_MS its
// own; PARENT the folder it is in. PENDING 1 when its text has not arrived
// here, and LENGTH then the sealed payload's, else the text's -- whose
// pieces follow as note_text rows. REACHABLE and CONTESTED where it stands
// (sec 828). COLOUR RRGGBBAA, 0 unset. TITLE and LABELS raw, LABELS
// NUL-separated, both empty while pending. REF an attachment's file
// reference, empty for any other note.
struct note_fields {
	u16  content_type;
	u8   flags;
	u64  created_ms;
	u64  edited_ms;
	u8   parent[32];
	u8   pending [max = 1];
	u32  length;
	u8   reachable [max = 1];
	u8   contested [max = 1];
	u32  colour;
	u8   title_len;
	u8   title[title_len];
	u16  labels_len [max = 1024];
	u8   labels[labels_len];
	u8   ref_len [max = 128];
	u8   ref[ref_len];
}

// A NOTE MADE under PARENT, zero for the top: CONTENT_TYPE the note's
// type, 1 a note, 2 a checklist, 3 a folder, as `add note|list|folder`
// make them; TITLE raw.
// Answered `added`, the new id, then a STATUS ok -- or a STATUS refusing
// it, in the verb's words.
struct add {
	u8   parent[32];
	u16  content_type [min = 1, max = 3];
	u8   title_len;
	u8   title[title_len];
}

struct added {
	u8   id[32];
}

// ONE FIELD of note ID: 1 its title, VALUE raw; 2 its labels, VALUE
// NUL-separated, empty for none; 3 its colour, VALUE four bytes RRGGBBAA;
// 4 its folder, VALUE the parent's 32-byte id, zero for the top; 5..10
// pin, unpin, trash, untrash, archive, unarchive, VALUE empty. A STATUS
// answers it.
enum field : u8 {
	title     = 1,
	labels    = 2,
	colour    = 3,
	parent    = 4,
	pin       = 5,
	unpin     = 6,
	trash     = 7,
	untrash   = 8,
	archive   = 9,
	unarchive = 10,
	default   = error,
}

struct change {
	u8    id[32];
	field field;
	u16   value_len [max = 1024];
	u8    value[value_len];
}

// A CHECKLIST'S ITEM: WHAT 1 adds TEXT at its end, 2 ticks item INDEX, 3
// unticks it, 4 removes it. A STATUS answers it.
struct item {
	u8   id[32];
	u8   what [min = 1, max = 4];
	u16  index;
	u16  text_len [max = 7900];
	u8   text[text_len];
}

// A PIECE OF NOTE ID's NEW TEXT, sec 1219: TOTAL its whole length, the
// pieces in order from OFFSET 0 and without a gap, at most 8000 bytes each
// so a message stays under the local leg's 0x1fff. A STATUS ok answers
// each; the last, at which the text is whole, saves it as `set note ID
// text` would, and its STATUS is the save's.
struct text {
	u8   id[32];
	u32  total [max = 262144];
	u32  offset;
	u16  piece_len [max = 8000];
	u8   piece[piece_len];
}

// SUBTREE shared with NAME -- a contact's name, or a group's as `@NAME` --
// or, ADD 0, no longer. CATCH_UP for a group: 0 or 1 whether a member who
// joins later gets what is below as it stands, 2 unsaid (sec 655). A
// STATUS answers it.
struct share {
	u8   subtree[32];
	u8   add [max = 1];
	u8   catch_up [max = 2];
	u8   name_len [min = 1, max = 64];
	u8   name[name_len];
}

// QUEUED the notes whose purge began; PENDING those waiting on other hosts
// holding them. Then a STATUS ok.
struct trash_emptied {
	u64  queued;
	u64  pending;
}

// A FILE ATTACHED under PARENT, zero for the top: REF its reference as
// `put file` answers it (72 bytes), TITLE raw. Answered `added`, then a
// STATUS ok.
struct attach {
	u8   parent[32];
	u8   ref[72];
	u8   title_len;
	u8   title[title_len];
}

// A PIECE of the note's text: OFFSET where it starts, in order and without
// a gap, so the pieces end where LENGTH says. At most 8000 bytes, so a
// message stays under the local leg's 0x1fff (FZN_LOCAL_BINARY_MAX).
struct note_text {
	u32  offset;
	u16  piece_len [max = 8000];
	u8   piece[piece_len];
}

// SUBTREE the note or folder shared. TO 0 a contact, by NAME; 1 a group,
// by NAME without its `@`, CATCH_UP 1 when a member who joins later gets
// what is under it as it stands (sec 655); 2 a key no contact or group
// here names, NAME its 64 hex. CATCH_UP is 0 but for a group.
struct share_row {
	u8   subtree[32];
	u8   to [max = 2];
	u8   catch_up [max = 1];
	u8   name_len [max = 64];
	u8   name[name_len];
}

// SHARER zero for this user's own notes, else the key of the contact whose
// shared tree is read, as `list shared KEY` names it. PARENT zero for the
// top, else the folder's id.
struct notes {
	u8   sharer[32];
	u8   parent[32];
}

// ID the note's. CONTENT_TYPE its kind. FLAGS its meta's, with 0x80 set
// when its text has not arrived here, so it lists by its meta alone.
// REACHABLE 1 when the tree's root reaches it; CONTESTED 1 when two claims
// put it under two parents. TITLE and LABELS raw, empty while the text has
// not arrived; LABELS NUL-separated.
struct note_row {
	u8   id[32];
	u16  content_type;
	u8   flags;
	u8   reachable [max = 1];
	u8   contested [max = 1];
	u8   title_len;
	u8   title[title_len];
	u16  labels_len [max = 1024];
	u8   labels[labels_len];
}

struct message {
	u8   cmd [must_eq = 8];
	op   op;

	variant body switch (op) {
		case op.notes:    notes    notes;
		case op.note_row: note_row note_row;
		case op.stamp:    nothing  stamp;
		case op.stamp_row: stamp_row stamp_row;
		case op.shares:   nothing  shares;
		case op.share_row: share_row share_row;
		case op.note:     note_ask note;
		case op.note_fields: note_fields note_fields;
		case op.note_text: note_text note_text;
		case op.add:      add      add;
		case op.added:    added    added;
		case op.change:   change   change;
		case op.item:     item     item;
		case op.text:     text     text;
		case op.share:    share    share;
		case op.trash_empty: nothing trash_empty;
		case op.trash_emptied: trash_emptied trash_emptied;
		case op.attach:   attach   attach;
		default: error;
	}
}
