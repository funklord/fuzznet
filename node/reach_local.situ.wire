# situ wire signature v3
# schema: reach_local.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum op : u8 unknown=error
  legs=128 legs_summary=129 leg_row=130

struct leg_row size=123..175
  @0x0000   1         u8         address_len  max=52
  @0x0001   0..52     u8         address  sized-by=address_len
  ~         1         u8         measured  max=1
  ~         8         u64        latency_ms  big
  ~         8         u64        loss_permille  big
  ~         8         u64        observations  big
  ~         8         u64        age_s  big
  ~         8         u64        asked  big
  ~         8         u64        answered  big
  ~         8         u64        sent  big
  ~         8         u64        received  big
  ~         8         u64        since_asked_ms  big
  ~         8         u64        since_answer_ms  big
  ~         4         u32        lost_in_row  big
  ~         4         u32        outstanding  big
  ~         1         u8         in_use  max=1
  ~         8         u64        cost_ms  big
  ~         8         u64        budget_limit  big
  ~         8         u64        budget_spent  big
  ~         8         u64        budget_window_ms  big

struct legs_summary size=8
  @0x0000   8         u64        unmeasured  big

struct message size=2..177
  @0x0000   1         u8         cmd  must_eq=12
  @0x0001   1         op         op
  @0x0002   0..175    variant    body
  body switch: op
  body case 128: legs nothing
  body case 129: legs_summary legs_summary
  body case 130: leg_row leg_row
  body case default: error

struct nothing size=0
