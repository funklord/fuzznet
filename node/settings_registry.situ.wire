# situ wire signature v3
# schema: settings_registry.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

struct address size=2..
  @0x0000   1         u8         lead  chars="\x2D.0-:A-Za-z"
  @0x0001   until:20  u8         host  cap=252 chars="\x2D.0-:A-Za-z"
  ~         0..       u16        port  sized-by=remaining radix=10 min=1

struct count size=0..
  @0x0000   0..       u64        value  sized-by=remaining radix=10

struct duration size=1..
  @0x0000   0..       u32        count  sized-by=remaining radix=10 leaves=1
  ~         1         time_unit  unit

struct flag size=0..
  @0x0000   0..       flag_word  word  sized-by=remaining

struct log_level size=0..
  @0x0000   0..       log_level_word word  sized-by=remaining

struct log_scope size=0..
  @0x0000   0..       log_scope_word word  sized-by=remaining

struct pressure_rank size=0..
  @0x0000   0..       pressure_rank_word word  sized-by=remaining

struct text size=0..
  @0x0000   0..       u8         bytes  sized-by=remaining chars="\x20-~"

registry node
  key="archive/erasure" cell=text default="4+2" display=advanced max_size=5 min_size=3 scope=estate
  key="archive/gone" cell=duration default="14d" display=advanced max=315360000 min=1 scope=estate
  key="archive/replicas" cell=count default="2" display=advanced max=16 min=1 scope=estate
  key="call/block-max" cell=duration default="1d" max=2592000 min=60 scope=estate\x20|\x20host
  key="call/ring" cell=duration default="45s" max=600 min=5 scope=estate\x20|\x20host
  key="call/ring-burst" cell=count default="10" max=1000 min=1 scope=estate\x20|\x20host
  key="call/ring-refill" cell=duration default="1m" max=86400 min=1 scope=estate\x20|\x20host
  key="contact/name/" cell=text family display=verb max_size=32 min_size=1 scope=estate
