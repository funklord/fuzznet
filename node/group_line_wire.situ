// A group line in transit, project.md sec 628: step 5b's second part, on
// sec 627's epochs. node/group_line.c builds and reads it through the code
// situ generates from this (sec 1326); `_wire`, so the generated file's
// name meets no source's (sec 1313).
//
// The head is in the clear and is the AEAD's associated data; the text is
// sealed under the hash of a label, the group epoch's secret and the
// sealing host, with a random nonce. Not signed: group lines are deniable
// (sec 625).
//
// What the schema says and the generated code checks: the text at most 512
// bytes and the line exactly its length. What it does not say yet: the
// sealing, done by the codec over the head as associated data.

target buffer;
endian big;

struct fzn_group_line {
	u8   version [must_eq = 1];
	u8   group[32];
	u32  epoch;                             // the group epoch, not a month
	u8   sender[32];                        // the member who wrote it, a root
	u8   host[32];                          // the host that sealed it
	u8   id[16];
	u64  stime;
	u8   nonce[24];
	u16  text_len [max = 512];
	u8   text[text_len];                    // sealed
	u8   tag[16];
}
