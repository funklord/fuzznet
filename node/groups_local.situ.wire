# situ wire signature v3
# schema: groups_local.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum op : u8 unknown=error
  list=128 row=129 members=130 member_row=131 change=132 created=133 proposed=134 backfill=135 backfill_row=136

enum what : u8 unknown=error
  create=1 leave=2 member_add=3 member_remove=4 admin_add=5 admin_remove=6 backfill_on=7 backfill_off=8

struct backfill_ask size=2..65
  @0x0000   1         u8         group_len  min=1 max=64
  @0x0001   1..64     u8         group  sized-by=group_len

struct backfill_row size=1
  @0x0000   1         u8         on  max=1

struct change size=4..131
  @0x0000   1         what       what
  @0x0001   1         u8         group_len  min=1 max=64
  @0x0002   1..64     u8         group  sized-by=group_len
  ~         1         u8         who_len  max=64
  ~         0..64     u8         who  sized-by=who_len

struct created size=32
  @0x0000   32        u8         id  big

struct member_row size=34..66
  @0x0000   32        u8         key  big
  @0x0020   1         u8         admin  max=1
  @0x0021   1         u8         name_len  max=32
  @0x0022   0..32     u8         name  sized-by=name_len

struct members_ask size=32
  @0x0000   32        u8         id  big

struct message size=2..133
  @0x0000   1         u8         cmd  must_eq=13
  @0x0001   1         op         op
  @0x0002   0..131    variant    body
  body switch: op
  body case 128: list nothing
  body case 129: row row
  body case 130: members members_ask
  body case 131: member_row member_row
  body case 132: change change
  body case 133: created created
  body case 134: proposed proposed
  body case 135: backfill backfill_ask
  body case 136: backfill_row backfill_row
  body case default: error

struct nothing size=0

struct proposed size=4
  @0x0000   2         u16        approvals  big
  @0x0002   2         u16        needed  big

struct row size=46..78
  @0x0000   32        u8         id  big
  @0x0020   4         u32        members  big
  @0x0024   1         u8         admin  max=1
  @0x0025   8         u64        lines  big
  @0x002d   1         u8         name_len  max=32
  @0x002e   0..32     u8         name  sized-by=name_len
