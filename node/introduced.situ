// Where an introduced host said hello from: the answer to an INTRODUCE, project.md
// sec 1077 (sec 623's rendezvous among an estate's hosts and sec 698's among a
// contact's). It was the text line `ok HOST PORT`, read by sscanf; a refusal is a
// STATUS (node/status.situ).
//
// What the schema cannot say and the reader checks: an address is letters, digits
// and `.-:`, as a contact device's is (node/contact_devices.situ).

target buffer;
endian big;

struct message {
	u8   family  [must_eq = 2];
	u8   type    [must_eq = 66];
	u8   address_len [min = 1, max = 45];
	u8   address[address_len];
	u16  port    [min = 1];
}
