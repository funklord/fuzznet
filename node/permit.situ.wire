# situ wire signature v3
# schema: permit.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

struct grant size=0..
  ~         1         u8         kind  peek skip=20
  ~         0..       variant    body
  body switch: kind
  body case 97: anyone anyone_word
  body case 103: group group_grant
  body case 108: local local_grant
  body case 117: user user_grant
  body case default: error
  body switch: first
  body case 64: group
  body case default: user
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text

struct group_grant size=7..
  @0x0000   6         u8         scheme  big must_eq="group:"
  @0x0006   1..64     target     who
  ~         until:20|end rights_word rights
  body switch: first
  body case 35: id
  body case default: text

struct group_list size=0..528
  @0x0000   0..528    group_name names  while=1 while-or-end while-max=16
  group_list refuses: name_twice when !unique(g in group_list.names: g.name)

struct group_name size=0..33
  @0x0000   until:20|end u8         name  cap=33 chars="\x2D.0-9_a-z"
  group_name refuses: name_length when count(group_name.name) < 1 || count(group_name.name) > 32

struct group_target size=2..65
  @0x0000   1         u8         sigil  must_eq=64
  @0x0001   1..64     target     who
  body switch: first
  body case 35: id
  body case default: text

struct host_rule size=5..70
  @0x0000   5         u8         scheme  big must_eq="host:"
  @0x0005   until:20|end u8         key  cap=65 chars="0-9a-f"
  host_rule refuses: key_length when count(host_rule.key) != 64

struct local_grant size=7..
  @0x0000   6         u8         scheme  big must_eq="local:"
  @0x0006   1..65     local_target who
  ~         until:20|end rights_word rights
  body switch: first
  body case 64: group
  body case default: user
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text

struct local_target size=1..65
  @0x0000   1         u8         first  peek
  @0x0000   1..65     variant    body
  body switch: first
  body case 64: group group_target
  body case default: user target
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text

struct numeric size=2..12
  @0x0000   1         u8         hash  must_eq=35
  @0x0001   until:3d  u64        id  radix=10 cap=11

struct permit size=0..
  @0x0000   0..       grant      grants  while=1 while-or-end
  body switch: kind
  body case 97: anyone
  body case 103: group
  body case 108: local
  body case 117: user
  body case default: error
  body switch: first
  body case 64: group
  body case default: user
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text
  body switch: first
  body case 35: id
  body case default: text

struct remote_permit size=1..
  @0x0000   1..       rule       rules  while=1 while-or-end
  body switch: kind
  body case 104: host
  body case default: word
  remote_permit refuses: no_rule when count(remote_permit.rules) == 0
  remote_permit refuses: none_alone when any(r in remote_permit.rules: r.kind == 'n') && count(remote_permit.rules) > 1

struct rule size=1..
  @0x0000   1         u8         kind  peek
  @0x0000   0..       variant    body
  body switch: kind
  body case 104: host host_rule
  body case default: word rule_word

struct target size=1..64
  @0x0000   1         u8         first  peek
  @0x0000   1..64     variant    body
  body switch: first
  body case 35: id numeric
  body case default: text text_name

struct text_name size=1..64
  @0x0000   until:3d  u8         text  cap=64 chars="\x2D.0-9A-Z_a-z"
  text_name refuses: empty_name when size(text_name.text) < 2

struct user_grant size=6..
  @0x0000   5         u8         scheme  big must_eq="user:"
  @0x0005   1..64     target     who
  ~         until:20|end rights_word rights
  body switch: first
  body case 35: id
  body case default: text
