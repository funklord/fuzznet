// This user's settings asked in binary on the local leg, starting with the
// forks: project.md sec 1187, what a forks view lists -- `list fork` as a
// row per head of each fork, every page in one answer.
//
// FZN_CMD_SETTINGS (24, wire/cmd.h), the local leg's alone as the sticker
// packs' 22 is: settings cross between hosts on the journal, not as
// requests, so no host asks another for them. A request is one message with
// no body; the answer is a row per head and then a STATUS ok, or a STATUS
// refusing it.

target buffer;
endian big;

enum op : u8 {
	forks    = 128, // every head of every fork, as `list fork` lists them
	fork_row = 129, // an answer: one head
	rules       = 130, // the retention rules, this host's or the estate's (sec 1258)
	rule_row    = 131, // an answer: one rule, in its words
	rule_add    = 132, // a rule added, as `add retention` or `add estate-retention`
	rule_remove = 133, // a rule removed, as `remove retention` or `remove estate-retention`
	value       = 134, // one setting's value as it stands here, its default where none is set (sec 1306)
	value_row   = 135, // an answer: the value
	setting     = 136, // a setting set or cleared where its declaration says, as `set|remove setting`
	default  = error,
}

struct nothing {
}

// A SETTING'S KEY, as the node declares it (`list schema`), slashed.
struct value_ask {
	u8   key_len [min = 1, max = 64];
	u8   key[key_len];
}

// ITS VALUE HERE: AT 0 the default, 1 this host's own, 2 set above this
// host -- its group's or the estate's; SENSITIVE 1 for a value never shown,
// VALUE then empty and AT saying only whether one is set; VALUE raw.
struct value_row {
	u8   at [max = 2];
	u8   sensitive [max = 1];
	u16  value_len [max = 256];
	u8   value[value_len];
}

// A SETTING SET TO VALUE, or cleared where CLEAR is 1 -- for this host or
// the estate, as its declaration says. VALUE as the verb takes it; a flag's
// `on` and `off`.
struct setting_ask {
	u8   clear [max = 1];
	u8   key_len [min = 1, max = 64];
	u8   key[key_len];
	u16  value_len [max = 256];
	u8   value[value_len];
}

// SUBJECT what was decided; HOST who decided this side; AT its record's
// version, ms; GROUNDS what it was decided from, raw; VALUE the side, raw.
struct fork_row {
	u8   subject_len [max = 56];
	u8   subject[subject_len];
	u8   host[32];
	u64  at;
	u8   grounds_len [max = 64];
	u8   grounds[grounds_len];
	u16  value_len [max = 256];
	u8   value[value_len];
}

// ESTATE 1 for the estate's rules, 0 for this host's.
struct rules_ask {
	u8   estate [max = 1];
}

// RULE in its words, `prune|keep PROGRAM ... age|size|count N` (log/retain.h).
struct rule_row {
	u16  rule_len [min = 1, max = 256];
	u8   rule[rule_len];
}

struct rule_change {
	u8   estate [max = 1];
	u16  rule_len [min = 1, max = 256];
	u8   rule[rule_len];
}

struct message {
	u8   cmd [must_eq = 24];
	op   op;

	variant body switch (op) {
		case op.forks:    nothing  forks;
		case op.fork_row: fork_row fork_row;
		case op.rules:       rules_ask   rules;
		case op.rule_row:    rule_row    rule_row;
		case op.rule_add:    rule_change rule_add;
		case op.rule_remove: rule_change rule_remove;
		case op.value:       value_ask   value;
		case op.value_row:   value_row   value_row;
		case op.setting:     setting_ask setting;
		default: error;
	}
}
