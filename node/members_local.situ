// This estate's other hosts, asked in binary on the local leg: project.md
// sec 1176, what the hosts view, the library and the main window list --
// `list sibling` as a row per host.
//
// FZN_CMD_MEMBERS (9, wire/cmd.h): siblings are the estate's members, so
// their local operations are this category's, in the range 128 to 191 kept
// for the local socket; between hosts the category's SUBCMDs are below it.
// A request is one message with no body; the answer is a row per host and
// then a STATUS ok, or a STATUS refusing it.

target buffer;
endian big;

enum op : u8 {
	siblings       = 128, // every other host of this estate this node knows
	sibling_row    = 129, // an answer: one host
	capabilities   = 130, // what this node holds, as `list capability` (sec 1188)
	capability_row = 131, // an answer: one capability
	grants         = 132, // every grant this node signed, as `list grant`
	grant_row      = 133, // an answer: one grant
	invite         = 134, // a code a device joins by, as `add invite` (sec 1250)
	invite_row     = 135, // an answer: the code
	waiting        = 136, // the devices waiting to be let in, as `list invite`
	waiting_row    = 137, // an answer: one device
	answer         = 138, // a waiting device let in or turned away
	roots          = 139, // the estate's roots, as `list root` (sec 1265)
	root_row       = 140, // an answer: one root
	quorum_row     = 141, // an answer, first: k, the votes or roots a change needs
	votes          = 142, // the votes this host holds, as `list vote`
	vote_row       = 143, // an answer: one vote
	successions    = 144, // the re-keys, as `list succession`
	rekey_row      = 145, // an answer: one re-key
	staged         = 146, // the changes staged to revert, as `list staged`
	staged_row     = 147, // an answer: one
	presets        = 148, // the profiles, as `get preset` and `list preset choices`
	preset_row     = 149, // an answer: one profile
	self           = 150, // this host as the hosts view shows it, in one (sec 1266)
	self_row       = 151, // an answer: this host
	default        = error,
}

struct nothing {
}

// KEY the host's. PAIRED 1 when either holds a pairing to the other.
// HEARD 1 when it has answered, HEARD_S then the seconds since it last did.
// WHERE where a round reaches it, HOST:PORT, empty for nowhere; NAME its own
// `host/name`, raw, empty for none.
struct sibling_row {
	u8   key[32];
	u8   paired [max = 1];
	u8   heard [max = 1];
	u64  heard_s;
	u16  where_len [max = 259];
	u8   where[where_len];
	u8   name_len [max = 32];
	u8   name[name_len];
}

// NAME the capability's -- member, admin, share, retention. HOLDS 1 when
// this node holds it now, verified as answered; HOPS its chain's hops, 0
// for one not held; EXPIRES when the last hop lapses, 0 for never.
struct capability_row {
	u8   name_len [max = 16];
	u8   name[name_len];
	u8   holds [max = 1];
	u8   hops;
	u64  expires;
}

// GRANTEE the key it was granted to; NAME the capability's, or `other`;
// EXPIRES 0 for never; STANDS 1 when the grantee holds it now -- 0 revoked
// or lapsed -- read from the revocations as answered.
struct grant_row {
	u8   grantee[32];
	u8   name_len [max = 16];
	u8   name[name_len];
	u64  expires;
	u8   stands [max = 1];
}

// AN INVITE: DELEGABLE 1 for a device of this estate, 0 for a contact;
// CONFIRM 0 as `invite/confirm` says, 1 a device waits to be let in, 2 it
// is let in at once; LIFE its seconds, 0 for the ten minutes.
struct invite_ask {
	u8   delegable [max = 1];
	u8   confirm [max = 2];
	u32  life [max = 86400];
}

// CODE `FZI1:...`, what the joining device is given.
struct invite_row {
	u8   code_len [max = 210];
	u8   code[code_len];
}

// KEY a device's, waiting on an invite that asks to be confirmed.
struct waiting_row {
	u8   key[32];
}

// KEY the waiting device's; LET_IN 1 to let it in, 0 to turn it away.
struct answer_ask {
	u8   key[32];
	u8   let_in [max = 1];
}

// KEY a root's; ACTING 1 where this host acts as it.
struct root_row {
	u8   key[32];
	u8   acting [max = 1];
}

struct quorum_row {
	u8   k;
}

// AGAINST the key voted against; VOTER who cast it; WITHDRAWN 1 once taken back.
struct vote_row {
	u8   against[32];
	u8   voter[32];
	u8   withdrawn [max = 1];
}

// OLD the device re-keyed, NEW its key now; STATE as the node words it.
struct rekey_row {
	u8   old_key[32];
	u8   new_key[32];
	u8   state_len [max = 23];
	u8   state[state_len];
}

// TOKEN what confirms it; DEADLINE when it reverts, as the node says it;
// KEY what it changed.
struct staged_row {
	u16  token_len [max = 256];
	u8   token[token_len];
	u8   deadline_len [max = 31];
	u8   deadline[deadline_len];
	u16  key_len [max = 256];
	u8   key[key_len];
}

// NAME a profile; IN_FORCE 1 for the one in force.
struct preset_row {
	u8   in_force [max = 1];
	u8   name_len [min = 1, max = 63];
	u8   name[name_len];
}

// HOST and USER this host's keys; NAME its `host/name`, raw, empty for
// none; MEMBER 1 where it holds the member capability; HELD and DELIVERED
// the lines this device wrote not yet settled, and of those delivered;
// PORT where it serves peers, 0 for nowhere.
struct self_row {
	u8   host[32];
	u8   user[32];
	u8   name_len [max = 64];
	u8   name[name_len];
	u8   member [max = 1];
	u64  held;
	u64  delivered;
	u16  port;
}

struct message {
	u8   cmd [must_eq = 9];
	op   op;

	variant body switch (op) {
		case op.siblings:       nothing        siblings;
		case op.sibling_row:    sibling_row    sibling_row;
		case op.capabilities:   nothing        capabilities;
		case op.capability_row: capability_row capability_row;
		case op.grants:         nothing        grants;
		case op.grant_row:      grant_row      grant_row;
		case op.invite:         invite_ask     invite;
		case op.invite_row:     invite_row     invite_row;
		case op.waiting:        nothing        waiting;
		case op.waiting_row:    waiting_row    waiting_row;
		case op.answer:         answer_ask     answer;
		case op.roots:          nothing        roots;
		case op.root_row:       root_row       root_row;
		case op.quorum_row:     quorum_row     quorum_row;
		case op.votes:          nothing        votes;
		case op.vote_row:       vote_row       vote_row;
		case op.successions:    nothing        successions;
		case op.rekey_row:      rekey_row      rekey_row;
		case op.staged:         nothing        staged;
		case op.staged_row:     staged_row     staged_row;
		case op.presets:        nothing        presets;
		case op.preset_row:     preset_row     preset_row;
		case op.self:           nothing        self;
		case op.self_row:       self_row       self_row;
		default: error;
	}
}
