// The signatures a host has verified, kept across a start, project.md sec 938.
// node/verify_memo.c writes and reads the file through the code situ generates from
// this (sec 1333); `_record`, so the generated file's name meets no source's.
//
// What the schema says and the generated code checks: the version, the count's bound
// (FZN_VERIFY_MEMO_HELD_MAX) and the file exactly its length. What it cannot say:
// `signature` is this host's own, over a hash of everything before it, and nothing is
// believed until it verifies.

target buffer;
endian big;

struct fzn_verify_memo_digest {
	u8   digest[32];                 // of a key, a message and a signature
}

struct fzn_verify_memo_file {
	u8   version [must_eq = 1];
	u32  count [max = 67108864];     // FZN_VERIFY_MEMO_HELD_MAX, 1 << 26
	fzn_verify_memo_digest digests[count];
	u8   signature[64];
}
