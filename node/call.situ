// A call's messages, host to host, in a session: project.md secs 1019-1027 and
// 1062, the pilot of sec 1068 -- the call family described here, its reader and
// its tests generated, where node/live.c read the bytes by hand. Its writer
// waits on situ building a message whose last member is `remaining`.
//
// FZN_CMD_CALL (18, wire/cmd.h), its kind the SUBCMD, the call's id: sec 1085 and
// 1087, where it was family 2, type 61, then the kind.

target buffer;
endian big;

enum kind : u8 {
	ring        = 1,   // a call asked, of a user
	answer      = 2,   // taken, on one of that user's clients
	decline     = 3,   // refused
	hangup      = 4,   // ended, by either end
	frame       = 5,   // a frame's piece
	report      = 6,   // what the receiver measured of a stream
	participant = 7,   // who a call of several numbers an index
	ringing     = 8,   // the callee still here, to each ring (sec 1062)
	no_answer   = 9,   // the callee's ring time passed unanswered (sec 1073)
	busy        = 10,  // the callee's guard refused the ring (sec 1074)
	answered_elsewhere = 11, // another host of the callee's user answered (sec 1090)
	declined_elsewhere = 12, // another host of the callee's user declined (sec 1090)
	// THE LOCAL LEG'S, sec 1113: between a host and its own client only, in the
	// range sec 1101 keeps for the local socket; a host refuses them from another.
	media_open  = 128, // a client's channel for the call's media, held open
	media       = 129, // a whole frame, either way on that channel
	// THIS USER'S CALLS ASKED AND ANSWERED, sec 1251: the call bar's polling.
	calls       = 130, // every live call, as `list call`; CALL zero
	call_row    = 131, // an answer: one call, CALL its id
	ended       = 132, // why CALL ended, as `get call ID`
	ended_row   = 133, // an answer: the reason, where it has ended
	respond     = 134, // CALL answered, declined or hung up
	history     = 135, // a contact's past calls, by name, sec 1255; CALL zero
	past_row    = 136, // an answer: one past call, CALL its id
	default     = error,
}

struct nothing {
}

// KINDS a mask of audio 1 and video 2, at least one.
struct ring {
	u8  kinds [min = 1, max = 3];
	u8  whom[32];
}

struct frame {
	u8   stream;
	u16  from;
	u32  seq;
	u32  at_ms;
	u16  piece;
	u16  pieces [min = 1];
	u8   media[remaining];
}

struct whole {
	u8   stream;
	u16  from;
	u32  seq;
	u32  at_ms;
	u8   media[remaining];
}
struct report {
	u8   stream;
	u32  received;
	u32  lost;
	u16  jitter_ms;
	u32  last_at_ms;
	u32  held_ms;
}

struct participant {
	u16  index [min = 1];
	u8   whom[32];
}

// STATE 1 ringing here, 2 ringing out, 3 up; KINDS audio 1, video 2; USER
// the other end's user (sec 1040), HAS_USER 0 where this host cannot say.
struct call_row {
	u8  state [min = 1, max = 3];
	u8  kinds [min = 1, max = 3];
	u8  has_user [max = 1];
	u8  user[32];
}

// WHY, `declined`, `busy`, `no-answer` and the rest (sec 1082).
struct ended_row {
	u8  why_len [min = 1, max = 23];
	u8  why[why_len];
}

// WHOSE: the contact's name, as this user named them.
struct history {
	u8  name_len [min = 1, max = 32];
	u8  name[name_len];
}

// A PAST CALL, messages/line.situ's fzn_message_call: DIRECTION 1 out, 2
// in; OUTCOME 1 answered, 2 missed, 3 declined, 4 busy, 5 no-answer, 6
// elsewhere, 7 failed; STARTED when it was rung, seconds since 1970;
// SECONDS how long it was up.
struct past_row {
	u8  direction [min = 1, max = 2];
	u8  kinds [min = 1, max = 3];
	u8  outcome [min = 1, max = 7];
	u64 started;
	u32 seconds;
}

// WHAT 2 answer, 3 decline, 4 hang up: the kinds that say them between hosts.
struct respond {
	u8  what [min = 2, max = 4];
}

struct message {
	u8         cmd    [must_eq = 18];
	kind       kind;
	u8         call[8];

	variant body switch (kind) {
		case kind.ring:        ring              ring;
		case kind.answer:      nothing           answer;
		case kind.decline:     nothing           decline;
		case kind.hangup:      nothing           hangup;
		case kind.frame:       frame             frame;
		case kind.report:      report            report;
		case kind.participant: participant       participant;
		case kind.ringing:     nothing           ringing;
		case kind.no_answer:   nothing           no_answer;
		case kind.busy:        nothing           busy;
		case kind.answered_elsewhere: nothing    answered_elsewhere;
		case kind.declined_elsewhere: nothing    declined_elsewhere;
		case kind.media_open:  nothing           media_open;
		case kind.media:       whole             media;
		case kind.calls:       nothing           calls;
		case kind.call_row:    call_row          call_row;
		case kind.ended:       nothing           ended;
		case kind.ended_row:   ended_row         ended_row;
		case kind.respond:     respond           respond;
		case kind.history:     history           history;
		case kind.past_row:    past_row          past_row;
		default: error;
	}
}
