// This user's contacts, listed (sec 1162), added, renamed and removed (sec
// 1167), asked in binary on the local leg: the category fuzzypickles named
// after messages (its inbox 20261114T1030Z), in the holder's A (sec 1152).
//
// FZN_CMD_CONTACTS (11, wire/cmd.h), its operation the SUBCMD, in the range
// 128 to 191 kept for the local socket; between hosts the category's SUBCMDs
// are below it. A request is one message with no body; the answer is a row
// per contact and then a STATUS ok, so an ended list is told from a cut
// connection, or a STATUS refusing it -- each framed as the local leg
// frames a message (sec 1113).

target buffer;
endian big;

enum op : u8 {
	list    = 128, // every contact, as `list contact` lists them
	row     = 129, // an answer: one contact
	add     = 130, // a contact added, or renamed (sec 1167)
	remove  = 131, // a contact removed, by key
	clash   = 132, // an answer to add: another contact of the same name
	default = error,
}

// Where a contact stands on the roster (sec 489): ACTIVE served; the rest
// named and served nothing -- removed on another member, retired, or held
// by a writer since revoked.
enum standing : u8 {
	active    = 0,
	suspended = 1,
	retired   = 2,
	absent    = 3,
	default   = error,
}

struct nothing {
}

// KEY the contact's root key; NAME this user's for them.
struct row {
	u8       key[32];
	standing standing;
	u8       name_len [max = 32];
	u8       name[name_len];
}

// KEY a root key and NAME this user's for them: a key already a contact is
// renamed. Answered by a `clash` per other contact holding the name (sec
// 893: a shared name is allowed, and refused at use), then a STATUS.
struct add {
	u8   key[32];
	u8   name_len [max = 32];
	u8   name[name_len];
}

struct keyed {
	u8   key[32];
}

struct message {
	u8   cmd [must_eq = 11];
	op   op;

	variant body switch (op) {
		case op.list:   nothing list;
		case op.row:    row     row;
		case op.add:    add     add;
		case op.remove: keyed   remove;
		case op.clash:  keyed   clash;
		default: error;
	}
}
