// The library, asked in binary on the local leg: project.md sec 1174, what
// a media library lists each time it opens -- every file this user's hosts
// describe, one row each, the join `fzn_rpc_library_list` did over three
// text listings (`list catalog`, its claims' issuers, `list file`).
//
// FZN_CMD_FILES (1, wire/cmd.h): the library is files, so its local
// operations are this category's, in the range 128 to 191 kept for the
// local socket; between hosts the category's SUBCMDs are below it. A
// request is one message with no body; the answer is a row per file and
// then a STATUS ok, or a STATUS refusing it.

target buffer;
endian big;

enum op : u8 {
	library     = 128, // every file the catalogue names, as the library lists them
	library_row = 129, // an answer: one file
	library_file = 130, // one file's row, by its root (sec 1190)
	file        = 131, // where one file stands here, as `get file ROOT` (sec 1203)
	file_row    = 132, // an answer: the file
	remove      = 133, // this host's copy let go, as `remove file ROOT` (sec 1303)
	share       = 134, // shared or not, as `set file ROOT public|private`, `grant|revoke file ROOT WHO`
	shares      = 135, // whom a file is shared with, as `get file ROOT shares`
	share_row   = 136, // an answer: one share
	catalog_add = 137, // a file described, as `add catalog ROOT NAME VALUE` (sec 1309)
	default     = error,
}

struct nothing {
}

// ROOT the file asked after: its row, as the listing gives it, then a
// STATUS ok; a STATUS error naming nothing when no live claim names it.
struct library_file {
	u8   root[32];
}

// ROOT the file asked after, catalogued or not: a file_row, then a STATUS
// ok; a STATUS ok alone when this host neither holds it nor is fetching it.
struct file {
	u8   root[32];
}

// WHERE THE FILE STANDS HERE, as `get file ROOT` says it. HELD the leaves
// here of TOTAL, LENGTH its bytes. STATE 0 asked for and nothing in, 1 part
// here, 2 whole. TO_EVERYONE 1 when every contact may fetch it; SHARES the
// contacts and groups it is shared with besides; BUSY 1 while a transfer
// runs on it.
struct file_row {
	u64  held;
	u64  total;
	u64  length;
	u8   state [max = 2];
	u8   to_everyone [max = 1];
	u32  shares;
	u8   busy [max = 1];
}

// A FILE SHARED, or taken back where ADD is 0: with every contact where
// TO is empty, else with the contact TO names or the group `@NAME`, as the
// verbs take them. Answered by a STATUS in the verb's words.
struct share {
	u8   root[32];
	u8   add [max = 1];
	u8   to_len [max = 33];
	u8   to[to_len];
}

// A FILE DESCRIBED: this host asserts NAME of the file ROOT is VALUE, raw
// -- the library's `name`, `kind` or `duration` among them. Answered by a
// STATUS in the verb's words.
struct catalog_add {
	u8   root[32];
	u8   name_len [min = 1, max = 64];
	u8   name[name_len];
	u16  value_len [max = 504];
	u8   value[value_len];
}

// ONE SHARE of a file: KIND 0 every contact, 1 a contact, 2 a group; KEY
// the contact's root or the group's id, zeros for every contact; NAME as
// this host knows it, empty where it knows none.
struct share_row {
	u8   kind [max = 2];
	u8   key[32];
	u8   name_len [max = 32];
	u8   name[name_len];
}

// ROOT the file's. SIZE its length in bytes where it is held or arriving
// here, else 0 -- the catalogue carries none. DURATION_MS, KIND and NAME
// the first live value of each in the catalogue's order, 0 or empty for
// none; NAME raw, at most 255 bytes, KIND at most 64. HOLDERS this user's
// hosts that claim it as its holder (C8, sec 1189), and this one when it
// holds it whole without having said so; HELD_HERE 1 when the bytes are whole here; ARRIVING how much has
// arrived, per mille, while it is being fetched -- 0 when it is not, and at
// least 1 once it is.
struct library_row {
	u8   root[32];
	u64  size;
	u64  duration_ms;
	u16  holders;
	u8   held_here [max = 1];
	u16  arriving [max = 1000];
	u8   kind_len [max = 64];
	u8   kind[kind_len];
	u8   name_len;
	u8   name[name_len];
}

struct message {
	u8   cmd [must_eq = 1];
	op   op;

	variant body switch (op) {
		case op.library:     nothing     library;
		case op.library_row: library_row library_row;
		case op.library_file: library_file library_file;
		case op.file:        file        file;
		case op.file_row:    file_row    file_row;
		case op.remove:      file        remove;
		case op.share:       share       share;
		case op.shares:      file        shares;
		case op.share_row:   share_row   share_row;
		case op.catalog_add: catalog_add catalog_add;
		default: error;
	}
}
