// The library, asked in binary on the local leg: project.md sec 1174, what
// a media library lists each time it opens -- every file this user's hosts
// describe, one row each, the join `fzn_rpc_library_list` did over three
// text listings (`list catalog`, its claims' issuers, `list file`).
//
// FZN_CMD_FILES (1, wire/cmd.h): the library is files, so its local
// operations are this category's, in the range 128 to 191 kept for the
// local socket; between hosts the category's SUBCMDs are below it. A
// request is one message with no body; the answer is a row per file and
// then a STATUS ok, or a STATUS refusing it.

target buffer;
endian big;

enum op : u8 {
	library     = 128, // every file the catalogue names, as the library lists them
	library_row = 129, // an answer: one file
	library_file = 130, // one file's row, by its root (sec 1190)
	file        = 131, // where one file stands here, as `get file ROOT` (sec 1203)
	file_row    = 132, // an answer: the file
	remove      = 133, // this host's copy let go, as `remove file ROOT` (sec 1303)
	share       = 134, // shared or not, as `set file ROOT public|private`, `grant|revoke file ROOT WHO`
	shares      = 135, // whom a file is shared with, as `get file ROOT shares`
	share_row   = 136, // an answer: one share
	catalog_add = 137, // a file described, as `add catalog ROOT NAME VALUE` (sec 1309)
	tags        = 138, // a held file read for its own tags, as `add tags ROOT` (sec 1447)
	tags_page   = 139, // the held files from FROM read so, as `add tags from N`
	tags_done   = 140, // an answer: how far the reading got, and what it asserted
	music       = 141, // every file that is music, as the music catalogue lists it (sec 1449)
	music_row   = 142, // an answer: one piece of music
	photos      = 143, // every file that is a photograph
	photo_row   = 144, // an answer: one photograph
	sound       = 145, // a held tune queued to be heard for its tempo, key and loudness, as `add sound ROOT` (sec 1457)
	sound_page  = 146, // the held tunes from FROM queued so, as `add sound from N`
	sound_done  = 147, // an answer: how far the queueing got, and how many wait to be heard
	default     = error,
}

struct nothing {
}

// ROOT the file asked after: its row, as the listing gives it, then a
// STATUS ok; a STATUS error naming nothing when no live claim names it.
struct library_file {
	u8   root[32];
}

// ROOT the file asked after, catalogued or not: a file_row, then a STATUS
// ok; a STATUS ok alone when this host neither holds it nor is fetching it.
struct file {
	u8   root[32];
}

// WHERE THE FILE STANDS HERE, as `get file ROOT` says it. HELD the leaves
// here of TOTAL, LENGTH its bytes. STATE 0 asked for and nothing in, 1 part
// here, 2 whole. TO_EVERYONE 1 when every contact may fetch it; SHARES the
// contacts and groups it is shared with besides; BUSY 1 while a transfer
// runs on it.
struct file_row {
	u64  held;
	u64  total;
	u64  length;
	u8   state [max = 2];
	u8   to_everyone [max = 1];
	u32  shares;
	u8   busy [max = 1];
}

// A FILE SHARED, or taken back where ADD is 0: with every contact where
// TO is empty, else with the contact TO names or the group `@NAME`, as the
// verbs take them. Answered by a STATUS in the verb's words.
struct share {
	u8   root[32];
	u8   add [max = 1];
	u8   to_len [max = 33];
	u8   to[to_len];
}

// A FILE DESCRIBED: this host asserts NAME of the file ROOT is VALUE, raw
// -- the library's `name`, `kind` or `duration` among them. Answered by a
// STATUS in the verb's words.
struct catalog_add {
	u8   root[32];
	u8   name_len [min = 1, max = 64];
	u8   name[name_len];
	u16  value_len [max = 504];
	u8   value[value_len];
}

// THE HELD FILES FROM THE FROM-TH read for their tags, at most a page of
// them a request (sec 1447). Answered by a tags_done, then a STATUS ok.
struct tags_page {
	u32  from;
}
// HOW FAR A READING GOT: NEXT the FROM to ask again from, TOTAL the files
// held -- the pages are done when NEXT is TOTAL -- and ASSERTED the
// catalogue's assertions it made that were not made already. For one file
// (`tags`), NEXT and TOTAL are 0.
struct tags_done {
	u32  next;
	u32  total;
	u32  asserted;
}
// HOW FAR A QUEUEING GOT (sec 1457): NEXT and TOTAL as tags_done's, QUEUED
// the tunes this request put in line, WAITING every tune still to be heard
// here, the one being heard among them. Heard in a process of their own, a
// tune at a time; what is found is asserted when it is.
struct sound_done {
	u32  next;
	u32  total;
	u32  queued;
	u32  waiting;
}
// ONE PIECE OF MUSIC, sec 1449: ROOT the file's; DURATION_MS, HOLDERS and
// HELD_HERE as the library row says them. TRACK and DISC with their
// totals, and YEAR, are the catalogue's words read as numbers -- "3/12"
// is 3 of 12, "1961-06-25" is 1961 -- 0 where none is said or it is no
// number. The words are the first live value of each, raw, at most 255
// bytes: the title, artist, album, album artist, genre and composer a file
// says of itself; what the host holding it heard (sec 1457) -- the BPM,
// the key, the first BEAT in seconds, the LOUDNESS in LUFS and the PEAK --
// and the ACOUSTID and RECORDING AcoustID named (sec 1459), as asserted, so
// a player reads its grid and level here (sec 1462); and the file's NAME,
// which a list shows where it has no title.
struct music_row {
	u8   root[32];
	u64  duration_ms;
	u16  holders;
	u8   held_here [max = 1];
	u16  track;
	u16  track_total;
	u16  disc;
	u16  disc_total;
	u16  year;
	u8   title_len;
	u8   title[title_len];
	u8   artist_len;
	u8   artist[artist_len];
	u8   album_len;
	u8   album[album_len];
	u8   album_artist_len;
	u8   album_artist[album_artist_len];
	u8   genre_len;
	u8   genre[genre_len];
	u8   composer_len;
	u8   composer[composer_len];
	u8   bpm_len [max = 16];
	u8   bpm[bpm_len];
	u8   key_len [max = 16];
	u8   key[key_len];
	u8   beat_len [max = 16];
	u8   beat[beat_len];
	u8   loudness_len [max = 16];
	u8   loudness[loudness_len];
	u8   peak_len [max = 16];
	u8   peak[peak_len];
	u8   acoustid_len [max = 36];
	u8   acoustid[acoustid_len];
	u8   recording_len [max = 36];
	u8   recording[recording_len];
	u8   name_len;
	u8   name[name_len];
}
// ONE PHOTOGRAPH, sec 1449: ROOT, SIZE, HOLDERS and HELD_HERE as the
// library row says them. WIDTH, HEIGHT and ORIENTATION (EXIF's 1 to 8) 0
// where unsaid. PLACE 1 when it was said where, LATITUDE and LONGITUDE then
// in ten-millionths of a degree, north and east positive. TAKEN the
// camera's "YYYY-MM-DDTHH:MM:SS", its own local time, empty where unsaid;
// CAMERA and NAME raw, at most 255 bytes. VIDEO 1 for a phone's video (sec
// 1460), a kind of `video/`, DURATION_MS its length, 0 where unsaid -- its
// TAKEN in UTC where no local time was written.
struct photo_row {
	u8   root[32];
	u64  size;
	u16  holders;
	u8   held_here [max = 1];
	u32  width;
	u32  height;
	u8   orientation [max = 8];
	u8   video [max = 1];
	u64  duration_ms;
	u8   place [max = 1];
	i32  latitude [min = -900000000, max = 900000000];
	i32  longitude [min = -1800000000, max = 1800000000];
	u8   taken_len [max = 19];
	u8   taken[taken_len];
	u8   camera_len;
	u8   camera[camera_len];
	u8   name_len;
	u8   name[name_len];
}
// ONE SHARE of a file: KIND 0 every contact, 1 a contact, 2 a group; KEY
// the contact's root or the group's id, zeros for every contact; NAME as
// this host knows it, empty where it knows none.
struct share_row {
	u8   kind [max = 2];
	u8   key[32];
	u8   name_len [max = 32];
	u8   name[name_len];
}

// ROOT the file's. SIZE its length in bytes where it is held or arriving
// here, else 0 -- the catalogue carries none. DURATION_MS, KIND and NAME
// the first live value of each in the catalogue's order, 0 or empty for
// none; NAME raw, at most 255 bytes, KIND at most 64. HOLDERS this user's
// hosts that claim it as its holder (C8, sec 1189), and this one when it
// holds it whole without having said so; HELD_HERE 1 when the bytes are whole here; ARRIVING how much has
// arrived, per mille, while it is being fetched -- 0 when it is not, and at
// least 1 once it is.
struct library_row {
	u8   root[32];
	u64  size;
	u64  duration_ms;
	u16  holders;
	u8   held_here [max = 1];
	u16  arriving [max = 1000];
	u8   kind_len [max = 64];
	u8   kind[kind_len];
	u8   name_len;
	u8   name[name_len];
}

struct message {
	u8   cmd [must_eq = 1];
	op   op;

	variant body switch (op) {
		case op.library:     nothing     library;
		case op.library_row: library_row library_row;
		case op.library_file: library_file library_file;
		case op.file:        file        file;
		case op.file_row:    file_row    file_row;
		case op.remove:      file        remove;
		case op.share:       share       share;
		case op.shares:      file        shares;
		case op.share_row:   share_row   share_row;
		case op.catalog_add: catalog_add catalog_add;
		case op.tags:        file        tags;
		case op.tags_page:   tags_page   tags_page;
		case op.tags_done:   tags_done   tags_done;
		case op.music:       nothing     music;
		case op.music_row:   music_row   music_row;
		case op.photos:      nothing     photos;
		case op.photo_row:   photo_row   photo_row;
		case op.sound:       file        sound;
		case op.sound_page:  tags_page   sound_page;
		case op.sound_done:  sound_done  sound_done;
		default: error;
	}
}
