// Peers whose clocks disagree with this node's, asked in binary on the
// local leg: project.md sec 1184, what a clock notice lists -- `list
// clock` as a row per peer, every page in one answer.
//
// FZN_CMD_TIME (15, wire/cmd.h): a clock is this category's, its local
// operations in the range 128 to 191 kept for the local socket; between
// hosts the category's SUBCMDs are below it. A request is one message with
// no body; the answer is a row per peer and then a STATUS ok, or a STATUS
// refusing it.

target buffer;
endian big;

enum op : u8 {
	clocks    = 128, // every peer whose clock disagrees, as `list clock` lists them
	clock_row = 129, // an answer: one peer
	default   = error,
}

struct nothing {
}

// KEY the peer's. AHEAD 1 when its frames arrive past this node's horizon,
// 0 when already expired. SECONDS how far outside the window, a lower bound
// on the disagreement; AT when last seen, seconds by this node's clock.
struct clock_row {
	u8   key[32];
	u8   ahead [max = 1];
	u64  seconds;
	u64  at;
}

struct message {
	u8   cmd [must_eq = 15];
	op   op;

	variant body switch (op) {
		case op.clocks:    nothing   clocks;
		case op.clock_row: clock_row clock_row;
		default: error;
	}
}
