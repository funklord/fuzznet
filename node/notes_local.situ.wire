# situ wire signature v4
# schema: notes_local.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum op : u8 unknown=error
  notes=128 note_row=129 stamp=130 stamp_row=131 shares=132 share_row=133 note=134 note_fields=135 note_text=136 add=137 added=138 change=139 item=140 text=141 share=142 trash_empty=143 trash_emptied=144 attach=145

enum field : u8 unknown=error
  title=1 labels=2 colour=3 parent=4 pin=5 unpin=6 trash=7 untrash=8 archive=9 unarchive=10

struct add size=35..290
  @0x0000   32        u8         parent  big
  @0x0020   2         u16        content_type  big min=1 max=3
  @0x0022   1         u8         title_len
  @0x0023   0..255    u8         title  sized-by=title_len

struct added size=32
  @0x0000   32        u8         id  big

struct attach size=105..360
  @0x0000   32        u8         parent  big
  @0x0020   72        u8         ref  big
  @0x0068   1         u8         title_len
  @0x0069   0..255    u8         title  sized-by=title_len

struct change size=35..1059
  @0x0000   32        u8         id  big
  @0x0020   1         field      field
  @0x0021   2         u16        value_len  big max=1024
  @0x0023   0..1024   u8         value  sized-by=value_len

struct item size=37..7937
  @0x0000   32        u8         id  big
  @0x0020   1         u8         what  min=1 max=4
  @0x0021   2         u16        index  big
  @0x0023   2         u16        text_len  big max=7900
  @0x0025   0..7900   u8         text  sized-by=text_len

struct message size=2..8044
  @0x0000   1         u8         cmd  must_eq=8
  @0x0001   1         op         op
  @0x0002   0..8042   variant    body
  body switch: op
  body case 128: notes notes
  body case 129: note_row note_row
  body case 130: stamp nothing
  body case 131: stamp_row stamp_row
  body case 132: shares nothing
  body case 133: share_row share_row
  body case 134: note note_ask
  body case 135: note_fields note_fields
  body case 136: note_text note_text
  body case 137: add add
  body case 138: added added
  body case 139: change change
  body case 140: item item
  body case 141: text text
  body case 142: share share
  body case 143: trash_empty nothing
  body case 144: trash_emptied trash_emptied
  body case 145: attach attach
  body case default: error

struct note_ask size=64
  @0x0000   32        u8         sharer  big
  @0x0020   32        u8         id  big

struct note_fields size=66..1473
  @0x0000   2         u16        content_type  big
  @0x0002   1         u8         flags
  @0x0003   8         u64        created_ms  big
  @0x000b   8         u64        edited_ms  big
  @0x0013   32        u8         parent  big
  @0x0033   1         u8         pending  max=1
  @0x0034   4         u32        length  big
  @0x0038   1         u8         reachable  max=1
  @0x0039   1         u8         contested  max=1
  @0x003a   4         u32        colour  big
  @0x003e   1         u8         title_len
  @0x003f   0..255    u8         title  sized-by=title_len
  ~         2         u16        labels_len  big max=1024
  ~         0..1024   u8         labels  sized-by=labels_len
  ~         1         u8         ref_len  max=128
  ~         0..128    u8         ref  sized-by=ref_len

struct note_row size=40..1319
  @0x0000   32        u8         id  big
  @0x0020   2         u16        content_type  big
  @0x0022   1         u8         flags
  @0x0023   1         u8         reachable  max=1
  @0x0024   1         u8         contested  max=1
  @0x0025   1         u8         title_len
  @0x0026   0..255    u8         title  sized-by=title_len
  ~         2         u16        labels_len  big max=1024
  ~         0..1024   u8         labels  sized-by=labels_len

struct note_text size=6..8006
  @0x0000   4         u32        offset  big
  @0x0004   2         u16        piece_len  big max=8000
  @0x0006   0..8000   u8         piece  sized-by=piece_len

struct notes size=64
  @0x0000   32        u8         sharer  big
  @0x0020   32        u8         parent  big

struct nothing size=0

struct share size=36..99
  @0x0000   32        u8         subtree  big
  @0x0020   1         u8         add  max=1
  @0x0021   1         u8         catch_up  max=2
  @0x0022   1         u8         name_len  min=1 max=64
  @0x0023   1..64     u8         name  sized-by=name_len

struct share_row size=35..99
  @0x0000   32        u8         subtree  big
  @0x0020   1         u8         to  max=2
  @0x0021   1         u8         catch_up  max=1
  @0x0022   1         u8         name_len  max=64
  @0x0023   0..64     u8         name  sized-by=name_len

struct stamp_row size=8
  @0x0000   8         u64        stamp  big

struct text size=42..8042
  @0x0000   32        u8         id  big
  @0x0020   4         u32        total  big max=262144
  @0x0024   4         u32        offset  big
  @0x0028   2         u16        piece_len  big max=8000
  @0x002a   0..8000   u8         piece  sized-by=piece_len

struct trash_emptied size=16
  @0x0000   8         u64        queued  big
  @0x0008   8         u64        pending  big
