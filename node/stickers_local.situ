// The sticker packs this user keeps, asked in binary on the local leg:
// project.md sec 1172, what the sticker picker lists each time it opens.
//
// FZN_CMD_STICKERS (22, wire/cmd.h), the local leg's alone as named
// objects' 21 is (sec 1152): no host asks another for its saved packs. A
// request is one message with no body; the answer is a row per pack and
// then a STATUS ok, or a STATUS refusing it.

target buffer;
endian big;

enum op : u8 {
	packs    = 128, // every pack saved, as `list sticker` lists them
	pack_row = 129, // an answer: one pack
	items    = 130, // one pack's stickers, as `list sticker PACK` lists them (sec 1248)
	item_row = 131, // an answer: one sticker
	keep     = 132, // a pack kept by its reference, as `add sticker REF` keeps it
	kept     = 133, // an answer: the pack kept, by its root
	forget   = 134, // a pack let go by its root, as `remove sticker ROOT`
	reference  = 135, // the reference a line carries, as `get sticker PACK ID [text WORDS]` (sec 1304)
	referenced = 136, // an answer: the reference
	art        = 137, // a rendition or the sound written to a file, as `get sticker PACK ID ROLE PATH`
	drawn      = 138, // an answer: what was written
	put        = 139, // a pack built from a spec, or a pack file kept, as `put sticker PATH` (sec 1308)
	default  = error,
}

struct nothing {
}

// ROOT and LENGTH the pack file's; HELD 1 when the file is whole here;
// ESTATE 1 when the pack is saved for every host of this user, 0 for this
// host alone; NAME the pack's, raw.
struct pack_row {
	u8   root[32];
	u64  length;
	u8   held [max = 1];
	u8   estate [max = 1];
	u8   name_len;
	u8   name[name_len];
}

// A PACK BY ITS ROOT, for its stickers or to let it go.
struct pack_ask {
	u8   root[32];
}

// ONE STICKER, as `list sticker PACK`'s row says it: its id, type and
// flags; the box the sender's words go in -- its limit in characters, 0
// for none, its place and size in the main rendition's pixels, its fill
// and ink as 0xRRGGBBAA, 0 the client's choice, its turn 0 to 359 -- and
// the main rendition's size the box is measured against; its description.
struct item_row {
	u64  id;
	u8   type;
	u16  flags;
	u16  text_limit;
	u16  text_x;
	u16  text_y;
	u16  text_w;
	u16  text_h;
	u32  text_fill;
	u32  text_ink;
	u16  text_turn [max = 359];
	u16  main_w;
	u16  main_h;
	u8   desc_len;
	u8   desc[desc_len];
}

// A PACK'S WHOLE REFERENCE, as a line carries it: root, key and length.
struct keep_ask {
	u8   root[32];
	u8   key[32];
	u64  length;
}

// THE PACK KEPT, by its root; ESTATE 1 when kept for the estate, 0 for
// this host alone (`ok ROOT host`).
struct kept_row {
	u8   root[32];
	u8   estate [max = 1];
}

// A FILE ON THIS HOST, by its absolute PATH: a spec to build a pack from,
// or a pack file to keep. Answered by the pack kept, as `keep` is.
struct put_ask {
	u16  path_len [min = 1, max = 1023];
	u8   path[path_len];
}

// A STICKER BY ITS PACK AND ID: the pack by its whole reference where
// HAS_KEY, else by the root of a pack saved here (KEY and LENGTH zeros).
struct sticker_ask {
	u8   has_key [max = 1];
	u8   root[32];
	u8   key[32];
	u64  length;
	u64  id;
}

// ITS REFERENCE, with the sender's words where WORDS_LEN is not 0 (raw, at
// most FZN_STICKER_TEXT_MAX bytes; the node refuses them for a sticker with
// no text box).
struct reference_ask {
	sticker_ask sticker;
	u8   words_len [max = 84];
	u8   words[words_len];
}

// THE REFERENCE, `fzn:sticker/...`, as a line carries it.
struct referenced_row {
	u16  ref_len [min = 1, max = 512];
	u8   ref[ref_len];
}

// A RENDITION BY ROLE -- 1 thumb, 2 inline, 3 main, 4 pop-up, the nearest
// where the sticker lacks it -- or 5 its sound, written to a NEW file at
// PATH, absolute.
struct art_ask {
	sticker_ask sticker;
	u8   role [min = 1, max = 5];
	u16  path_len [min = 1, max = 1023];
	u8   path[path_len];
}

// WHAT WAS WRITTEN: a rendition's FORMAT, WIDTH and HEIGHT, all 0 for a
// sound; BYTES the sound's length, 0 for a rendition.
struct drawn_row {
	u8   format [max = 4];
	u16  width;
	u16  height;
	u64  bytes;
}

struct message {
	u8   cmd [must_eq = 22];
	op   op;

	variant body switch (op) {
		case op.packs:    nothing  packs;
		case op.pack_row: pack_row pack_row;
		case op.items:    pack_ask items;
		case op.item_row: item_row item_row;
		case op.keep:     keep_ask keep;
		case op.kept:     kept_row kept;
		case op.forget:   pack_ask forget;
		case op.reference:  reference_ask  reference;
		case op.referenced: referenced_row referenced;
		case op.art:        art_ask        art;
		case op.drawn:      drawn_row      drawn;
		case op.put:        put_ask        put;
		default: error;
	}
}
