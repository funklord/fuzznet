// Gathering a host's log: a troubleshooter asks for a program's lines in
// a time window, or those matching a name, a page at a time. sec 463, the
// last step of sec 456's order; log/gather.c encodes and decodes it by
// hand and this is the contract.
//
// THE VERSION IS 4, AND THAT IS THE DISPATCH, beside the spool's 1, notes
// sync's 2 and the causes envelope's 3.
//
// WHAT TRAVELS IS CLASSIC LINES, whole: every one is complete on its own
// and escaped (log/entry.h), so a page is lines a reader can grep, and a
// line never splits across pages.
//
// THE CURSOR is a segment's key -- its closing time, the current file
// being the largest -- and an offset into its lines, so a page resumes
// where the last stopped even as segments are closed and packed.
//
// Big-endian, like everything this tree writes.

target buffer;
endian big;

enum fzn_gather_type : u8 {
	query      = 1,   // "These lines, from this cursor."
	lines      = 2,   // "These, and where to go on from."
	ring_query = 3,   // "Your flight recorder, after this position." sec 464
	ring       = 4,   // "These records."
	segments_query = 5,   // "Your packed segments after this key." sec 483
	segments       = 6,   // "These, with their sizes."
	part_query     = 7,   // "This segment's bytes from here."
	part           = 8,   // "These."
}

struct fzn_gather_query {
	u8               version     [must_eq = 4];
	fzn_gather_type  type        [must_eq = query];
	u64              since_us;   // lines at or after this time
	u64              until_us;   // and at or before this one
	u64              cursor_key; // 0 to begin
	u64              cursor_off;
	u8               program_len [min = 1, max = 64];
	u8               program[program_len];
	u8               match_len   [max = 64];    // 0 for every line
	u8               match[match_len];          // a substring a line must hold
}

struct fzn_gather_line {
	u16  len [min = 1];
	u8   line[len];
}

// THE FLIGHT RECORDER ON REQUEST, sec 464: whole performant records, a
// page at a time, after the last position sent -- a process's positions only
// rise, so entries arriving or evicted between pages neither tear a record
// nor repeat one.
struct fzn_gather_ring_query {
	u8               version [must_eq = 4];
	fzn_gather_type  type    [must_eq = ring_query];
	u8               started [max = 1];   // 0: from the oldest held
	u64              after;               // else: past this position
}

struct fzn_gather_record {
	u16  len [min = 55, max = 4672];
	u8   record[len];                     // a fzn_entry_record
}

struct fzn_gather_ring {
	u8                 version [must_eq = 4];
	fzn_gather_type    type    [must_eq = ring];
	u8                 done    [max = 1];
	u16                count;
	fzn_gather_record  records[count];
}

struct fzn_gather_lines {
	u8               version   [must_eq = 4];
	fzn_gather_type  type      [must_eq = lines];
	u8               done      [max = 1];   // 1: nothing after this page
	u64              cursor_key;
	u64              cursor_off;
	u16              count;
	fzn_gather_line  lines[count];
}

// COPIES OF A HOST'S PACKED LOG, sec 483 (log/copy.h): its packed segments,
// listed by name and size after the newest a copier holds, and fetched a
// part at a time. Only a packed segment's own name is served.
struct fzn_log_copy_segments_query {
	u8               version     [must_eq = 4];
	fzn_gather_type  type        [must_eq = segments_query];
	u8               program_len [min = 1, max = 64];
	u8               program[program_len];
	u64              after;      // segments closed after this key
}

struct fzn_log_copy_segment {
	u8   name_len [min = 1];
	u8   name[name_len];         // PROGRAM.TIME.PID.log.zst
	u64  size;
}

struct fzn_log_copy_segments {
	u8                    version [must_eq = 4];
	fzn_gather_type       type    [must_eq = segments];
	u8                    done    [max = 1];
	u8                    count   [max = 64];
	fzn_log_copy_segment  segments[count];
}

struct fzn_log_copy_part_query {
	u8               version  [must_eq = 4];
	fzn_gather_type  type     [must_eq = part_query];
	u8               name_len [min = 1];
	u8               name[name_len];
	u64              offset;
}

struct fzn_log_copy_part {
	u8               version [must_eq = 4];
	fzn_gather_type  type    [must_eq = part];
	u8               done    [max = 1];
	u64              total;
	u64              offset;
	u32              len;
	u8               bytes[len];
}
