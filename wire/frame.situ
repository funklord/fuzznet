// fuzznet's datagram, as a schema rather than as hand-written C.
//
// project.md sec 6 settled that this file exists: situ's cryptographic model
// is built, not planned, so the frame is described and both ends are
// generated. What is NOT settled is anything sec 12 lists as an open
// candidate, and this file marks those rather than quietly deciding them.
//
// The purpose of the first revision is to be MEASURED. sec 10 names the
// real question as whether our frame trips situ's unbounded-scan or
// canonicality rules; `situc map` and `situc wire` answer that, and the
// answers belong in project.md before anyone writes a state machine
// against this.

target buffer;
endian big;

// --------------------------------------------------------------------------
// The codec
//
// Monocypher's XChaCha20-Poly1305, bound as an extern rather than wrapped --
// netcfgd's decision 1 puts one crypto implementation across the family, and
// sec 4.5 vendors it once here rather than three times.
//
// `length_preserving` describes the ciphertext core only; the tag is declared
// separately below, which is what the packet example means by the same note.
// `seekable` is claimed because the core is a stream cipher: it is what buys
// interior addressing in the sealed region, and if it were ever wrong the
// capability map would stop claiming fixed interior offsets rather than
// silently produce a wrong accessor.
codec fzn_aead {
	granularity = byte;
	length_preserving;
	seekable;
	authenticated;
	invertible;
	deterministic;
}

impl fzn_aead extern "fzn_aead_xchacha20poly1305";

// --------------------------------------------------------------------------
// What a datagram is for.
//
// Deliberately small, and deliberately NOT a command vocabulary. sec 5 keeps
// consumer commands out of the core: these say what the TRANSPORT must do,
// and a consumer's own command byte travels inside the sealed payload where
// this library never looks at it.
// A CLOSED SET, AND ADDING TO IT IS A CONVERSATION RATHER THAN AN EDIT.
// `fzn_head_validate` refuses a value outside this list, so an implementor
// who needs a new frame type cannot simply assign one: the frame would be
// rejected before decryption by every other host.
//
// That is deliberate and it is not meant to be a wall. A transport genuinely
// may need shapes these four do not cover -- a keepalive that carries a
// timestamp, a probe, a fragment of a stream rather than of a message. The
// rule is that an implementor MOTIVATES the new kind to fuzznet first and it
// is analysed case by case, because a kind is the one field every host must
// agree about before it can read anything else: two networks that assigned
// 0x04 differently would each refuse the other's traffic as malformed and
// neither would be wrong.
//
// What does NOT need a new kind is a consumer's command vocabulary. That
// goes in the sealed payload, where this library never looks -- see below.
//
// SETTLED 2026-08-26 BY THE COPYRIGHT HOLDER, because a consumer asked
// whether it could assign kinds in the unused range and the answer shapes
// their build: **for now everything passes through fuzznet's decision
// process.** A consumer does not take a value from the remainder on its own
// authority, however plainly free it looks -- the validator above stays the
// gatekeeper and the four values stay the whole set until a case is made and
// analysed.
//
// The holder also named where this is expected to go: "we may need a way to
// VENDOR them". So the anticipated end state is a mechanism by which a
// project is allotted space it may assign within, rather than either a
// permanent monopoly here or a free-for-all in the remainder. That mechanism
// is not designed and not built, and until it is, the process is the
// mechanism.
//
// Two consumers assigning 0x04 differently is the failure this prevents, and
// it is not recoverable by either of them: each would refuse the other's
// traffic as malformed and neither would be wrong.
enum fzn_kind : u8 {
	// Padding, liveness, and the thing a cover-traffic scheduler sends.
	nop       = 0x00,
	// One self-contained request or response.
	unit      = 0x01,
	// One piece of something larger -- see the chunk fields below.
	chunk     = 0x02,
	// An acknowledgement. ANY acknowledgement -- this says what the
	// transport should do with the frame and not what the frame contains.
	//
	// THIS SAID "carrying the bitmap" AND A CONSUMER READ IT AS A
	// CONSTRAINT, correctly, because it is written as one. It described
	// what THIS library's own ack would carry, at a time when that was the
	// only one anybody had imagined, and fuzzypickles asked in 2026-09-01
	// whether an acknowledgement carrying a sealed commitment and a tag
	// rather than a bitmap was entitled to the value.
	//
	// It is. Nothing in this library branches on this value: the generated
	// validator accepts the four and rejects the rest, and no code path
	// reads `ack` and expects a bitmap. So the bitmap was never a property
	// of the KIND, and a comment describing one use as though it were the
	// definition is the same shape as a reason recorded once and inherited
	// by everything after it.
	//
	// WHAT IS STILL CLOSED is the SET. Assigning an unused value remains a
	// conversation rather than an edit, per the 2026-08-26 settlement. Using
	// an assigned one for the plain meaning of its name is not assigning.
	//
	// sec 12's open question -- whether this should be a kind at all or a
	// policy the header states -- is unchanged by any of this.
	ack       = 0x03,
}

// --------------------------------------------------------------------------
// The header a forwarder may read and rewrite.
//
// OUTSIDE every covered region, and that placement is the whole reason this
// half exists separately. sec 3 puts an unprivileged bridge between the
// network and the daemon, and a bridge that had to re-authenticate a datagram
// to decrement a hop counter would be re-signing traffic it is not trusted to
// author. situ makes the pressure visible instead of leaving it folklore:
// mutating a covered field marks the tag dirty and the generated API refuses
// a transmittable buffer until it is recomputed.
struct fzn_hop {
	// THIS BYTE IS PLAINTEXT, ATTACKER-MUTABLE, AND NOT COVERED BY THE
	// TAG -- fzn_hop sits OUTSIDE the authenticated{} block below, which is
	// deliberate and correct: a relay decrements hops_left in flight, so
	// covering this struct would make every forward invalidate the tag.
	//
	// It is SAFE TODAY AND LATENT, and the distinction is the whole reason
	// this comment is here rather than in project.md. There is one version,
	// so `must_eq = 1` turns a flipped byte into a refusal by
	// situ_fzn_hop_validate -- reached from situ_fzn_frame_validate in
	// wire/seal.c before the AEAD runs, so it is denial rather than
	// confusion, and there is nothing to downgrade TO.
	//
	// THE MOMENT A VERSION 2 EXISTS, THIS BYTE CHOOSES WHICH PARSER RUNS,
	// and an attacker on the path picks it for free. Whoever adds one owes
	// this frame a way to bind the choice -- the version inside the
	// authenticated head, or a per-version key derivation, or a refusal to
	// carry two at once. It is written at the line that declares the byte
	// because that is what the person adding version 2 will be looking at,
	// and a design document is not.
	//
	// NOT THE SAME BYTE AS FZN_SIGNED_VERSION, which is at offset 0 of
	// every hop, revocation and record in wire/bytes.h and IS inside each
	// object's signed range. Two version bytes doing two different jobs:
	// that one authenticates what an object is, this one says how to read a
	// datagram before anything has been authenticated at all.
	u8  version   [must_eq = 1];
	u8  hops_left;
	// Three bytes so every multi-byte field below keeps its natural
	// boundary. The packet example pays exactly this and says why: the
	// alignment shows up in the capability map rather than in a comment.
	reserved u8[3];
}

// --------------------------------------------------------------------------
// The authenticated header: read by the recipient, covered by the tag,
// readable by anyone on the path.
//
// Everything here is plaintext ON PURPOSE. A recipient must decide whether to
// spend a decryption before spending it, and the fields that decide that --
// who it claims to be from, which session, whether it has expired -- cannot
// themselves be sealed without a chicken-and-egg problem.
struct fzn_head {
	fzn_kind  kind;

	// WHO IS SPEAKING, and the field that selects the key.
	//
	// The first revision of this schema had no key selector at all: a
	// receiver was handed a nonce and a sealed region with no way to know
	// which key opened it. Writing the schema is what made that absence
	// visible, since situ will describe an undecryptable frame perfectly
	// happily -- it checks layout, not that the protocol closes.
	//
	// It is the sender's host public key rather than a session handle, which
	// is fuzzypickles' answer (`sender_host_pubkey` in its peer frame) and is
	// the expensive side of a real choice: 32 bytes on every datagram buys a
	// frame that is SELF-CONTAINED. A handle is meaningless to a host that
	// has forgotten the session, never had it, or is handed the datagram by a
	// relay hours later -- and fuzzypickles' sec 8, "assume the peer is
	// asleep", is exactly that case. sec 13 records the alternative and why
	// it is not free.
	u8   sender[32];

	// sec 4.3, and the rule that looks like a contradiction between the two
	// consumers and is not: GRANTS DO NOT EXPIRE, COMMANDS DO. This is a
	// command's expiry, an absolute second, and a receiver refuses a frame
	// whose expiry has passed. Zero means "no expiry", which a receiver
	// refuses for anything it treats as a command -- the check lives in the
	// consumer because only it knows which of its commands are commands.
	u64  expires_at;

	// Replay defence and the AEAD nonce in one. 24 bytes because XChaCha
	// takes that, which is what makes a random nonce safe without a counter
	// negotiated per session.
	u8   nonce[24];

	// KEY COMMITMENT. sec 4.4a says key-committing AEAD is not optional,
	// and XChaCha20-Poly1305 as Monocypher provides it is not key-
	// committing: a ciphertext can be made to open under two different
	// keys, so an attacker who controls one of them can make one frame
	// mean two things to two recipients.
	//
	// The fix is the one fuzzypickles already ships and this family has
	// reviewed: derive 48 bytes from ONE hash over the key transcript --
	// 32 for the AEAD key and 16 for this -- and carry the 16 here.
	// A receiver derives both, compares this, and refuses on mismatch.
	// Deriving them together is what makes the commitment bind the key
	// rather than merely accompany it.
	//
	// IN THE AUTHENTICATED HEADER RATHER THAN INSIDE THE SEAL, and that
	// placement is the whole point rather than a layout preference. The
	// commitment exists to be checked BEFORE a decryption is spent; inside
	// the seal it could only be checked after, which is the cost it was
	// added to avoid, and it would be unreadable to a receiver holding the
	// wrong key -- which is exactly the receiver it has to warn.
	//
	// It costs 16 bytes on every datagram, and sec 13 is separately
	// arguing about the 32 that `capability` used to cost out here. That
	// argument is now harder, not easier, and this comment is not the
	// place to pretend otherwise: the two want settling together.
	u8   commitment[16];

	// Reassembly, sec 4.4. A message is identified by `msg`, and a chunk by
	// its index within it. `chunks` is the total, so a receiver can size its
	// reassembly buffer from the FIRST piece to arrive rather than
	// discovering the extent as it goes -- which is what lets sec 4.4's
	// memory bound be enforced up front instead of after the fact.
	//
	// A `unit` frame sets chunks = 1 and index = 0, so there is one shape on
	// the wire rather than two. That is a deliberate cost: eight bytes on
	// every small datagram, against a reassembly path that has no special
	// case for the common message. Whether that trade is right is a thing
	// to measure, not to assert.
	u32  msg;
	// `index < chunks`, spelled as a bound the schema enforces rather than a
	// check the reassembly code remembers. situ's decision 0030 is what
	// prompted this: `fuzznet` had offered "a chunk's index is below its
	// count" as an example of a CROSS-message relation, and that record
	// counted it correctly as a single-message constraint expressible today.
	// The miscount is worth keeping -- a constraint filed under "needs a
	// feature that does not exist" is a constraint nobody writes.
	//
	// `chunks - 1` rather than `chunks`, because index is zero-based and
	// `max = chunks` would admit one past the end. The bound appears in
	// `situc wire` output, so it is contract rather than comment.
	u16  index    [max = chunks - 1];
	u16  chunks;

	// Sizes the sealed payload. The `max` is what makes a datagram
	// statically allocatable: without it the sealed region is Unbounded and
	// no receiver can size a buffer for one, which is fuzzypickles' sec 8,
	// "receivers may have kilobytes", expressed where the compiler can
	// enforce it.
	//
	// 1024 is a placeholder chosen to be smaller than any plausible MTU.
	// NOT a placeholder any more, and not netcfgd's number to give. A
	// response's size sets how MANY chunks there are, not how big one is;
	// what bounds a chunk is the smallest path it must cross whole, since
	// fragmented UDP is widely dropped and avoiding it is why this library
	// chunks at all. RFC 8200 guarantees 1280 bytes on every IPv6 link,
	// less 48 of IPv6 and UDP headers, less 144 of frame: 1088 is the
	// largest payload that fits, and 1024 sits under it with 64 bytes of
	// room for an extension header or a tunnel. Asserted in
	// wire/test/constants_test.c. The 2018 generation picked 512 (sec 12).
	u16  length   [max = 1024];
}

// --------------------------------------------------------------------------
// The datagram.
struct fzn_frame {
	fzn_hop  hop;

	authenticated {
		fzn_head  head;
	}

	sealed(fzn_aead, nonce = head.nonce) {
		// WHICH CAPABILITY THE SENDER CLAIMS, and it is in here rather than
		// in the plaintext header on purpose.
		//
		// It was in the header in the first revision, which was two mistakes
		// at once. It was redundant -- `sender` above already says whose
		// capabilities to look up, and the chain that would prove this one is
		// not in the frame at all, so a receiver must consult its own records
		// either way. And it LEAKED: a capability identifier in the clear
		// tells an observer which authority is being exercised on every
		// datagram, so the frames worth attacking announce themselves. For a
		// protocol that reconfigures infrastructure across untrusted
		// networks, that is metadata worth 32 bytes of ciphertext to hide.
		//
		// CARRY A REAL ONE IN EVERY DATAGRAM, INCLUDING CHAT (decided
		// 2026-08-26). The 32 bytes are spent whether or not they mean
		// anything, so a null saves nothing -- and a capability
		// presented per datagram means a revoked host's very NEXT frame
		// is refused, where a per-session one keeps acting until
		// something tears the session down. This library has no
		// sessions to tear down. sec 4.2 makes revocation the thing
		// that ends authority here, and this is what makes it prompt.
		//
		// This library enforces none of it: fzn_seal_open verifies no
		// chain. A consumer putting zero here has chosen to have no
		// revocation granularity on that traffic, which may be right
		// and should be a sentence somebody wrote.
		//
		// QUALIFIED THE SAME DAY, by fuzzypickles checking it: "real"
		// is only available where the RECEIVER holds an anchor for the
		// sender's chain. Between two of one user's own hosts it does.
		// From another user's host, whose capabilities hang from their
		// own root, a capability is an assertion the receiver cannot
		// check -- and a zero there is a symptom of the anchoring
		// stopping at identity rather than a choice. See project.md
		// sec 5.
		//
		// Still this library's field rather than the consumer's: sec 4.2 has
		// the core verifying the CHAIN while never interpreting what a
		// capability permits. Being inside the seal does not change that --
		// the core reads it after opening, the consumer's own bytes follow.
		u8  capability[32];

		// The consumer's own bytes. This library does not know what they
		// mean and must not learn: sec 5 keeps command vocabularies out of
		// the core, and this is where that promise is kept.
		//
		// Sized from `head.length`, a plaintext field parsed before the
		// region, rather than from `remaining` -- `remaining` runs to the
		// end of the frame and would swallow the tag that follows.
		u8  payload[head.length];
	}

	tag u8[16];
}

// --------------------------------------------------------------------------
// What must hold, stated so the compiler checks it rather than a reviewer.

// One encoding per value, which is what makes a frame signable at all and is
// the property sec 4.1 exists to buy.
require canonical(fzn_frame);

// No parse before verify. sec 6 calls this unrepresentable rather than
// forbidden; this is the line that asks situ to prove it.
require verify_gated(fzn_frame.sealed);

// The forwarder's fields are writable in place and cost no recomputation --
// the property sec 3's unprivileged bridge depends on.
require no_tag_invalidation(fzn_frame.hop.hops_left);
require in_place(fzn_frame.hop.hops_left);

// And the converse, stated so the conflict is documented rather than
// discovered: an authenticated field is writable, but the tag goes stale and
// finalize must put it right. A relay that tried to rewrite the expiry would
// be re-authenticating traffic it cannot author.
require in_place_dirty(fzn_frame.head.expires_at);

// --------------------------------------------------------------------------
// Relations: what has to hold between two frames.
//
// situ's rung 3 (`relate`, decision 0030) landed on 2026-08-08 and this is
// the first schema to use it. A relation is a pure predicate over exactly two
// views -- it holds no state, allocates nothing, and does not know which
// frames exist -- so the CALLER owns the pairing and this only answers
// whether a pairing is well-formed.
//
// That is a property of THIS rung and not the shape of the ladder. An
// earlier revision of this comment drew the general conclusion that "the
// reassembly table is sec 4.4's state machine and stays this library's
// own", and project.md sec 6 records that as wrong: the rungs above are
// defined by exactly the state a relation refuses -- `frame` may hold bytes
// between calls, `converse` may hold messages between calls, and `drive`
// sends, retransmits and times out. Who owns sec 4.4's reassembly is a
// `--layer` choice that sec 7a leaves open, and is not this comment's to
// settle.

// THE ONE THAT MATTERS, and it is a security property rather than tidiness.
//
// A reassembler sizes its buffer from the FIRST chunk of a message it sees
// (sec 4.4: the bound has to be enforced up front rather than discovered as
// pieces arrive). Every later chunk therefore has to agree with that first
// one, and each clause below is a way an attacker splices something into
// somebody else's reassembly if it is not checked:
//
//   msg      -- otherwise the pieces are simply of different messages;
//   chunks   -- a later chunk claiming a different total is an attempt to
//               resize a buffer that has already been allocated against the
//               first claim, which is the interesting attack;
//   sender   -- without it, two senders' chunks reassemble into one message,
//               and the result authenticates as neither.
//
// Parameter order is temporal, which decision 0030 makes load-bearing: the
// first parameter is the frame seen first, so `first` is the one the buffer
// was sized from and there is no way to write this relation without saying
// which is which.
relation same_message(first: fzn_frame, later: fzn_frame) {
	must later.head.msg    == first.head.msg;
	must later.head.chunks == first.head.chunks;
	must later.head.sender == first.head.sender;
}

// A reply belongs to its request. Weaker than the above -- it says only that
// the identifier matches -- and it is here because a dissector and a fuzz
// harness both want it: one to say "response to frame N", the other to
// generate a reply that gets past the first check rather than by luck.
relation reply_to(request: fzn_frame, reply: fzn_frame) {
	must reply.head.msg    == request.head.msg;
	must reply.head.sender != request.head.sender;
}
