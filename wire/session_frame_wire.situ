// The session frame, project.md secs 924 and 932: 33 bytes before a payload,
// for two ends that are both awake. wire/session_frame.c reads the head and
// keeps the replay window through the code situ generates from this (sec
// 1320); `_wire`, so the generated file's name meets no source's (sec 1313).
//
// What the schema says and the generated code checks: the head's mark, a
// counter never 0, and the window below. What it cannot say and the codec
// does: the text opens under the direction's key, its nonce the counter,
// with the nine bytes of head as associated data.

target buffer;
endian big;

// A frame is this head, then the sealed text, then a 16-byte tag, and the
// datagram's end says where the tag is: no length is sent.
struct fzn_session_frame_head {
	u8   mark [must_eq = 250];
	u32  handle;                     // the receiver's number for the session
	u32  counter [min = 1];          // this direction's; never again under this key
}

// What the seal opens to, the payload after it.
struct fzn_session_text {
	u32  msg;
	u32  expires;                    // seconds, 0 for none
}

// The bodies of the two full frames that begin one, after a payload's version
// and type (node/types.h).
struct fzn_session_ask {
	u8   random[16];
	u32  handle;                     // what the asker hears under
}

struct fzn_session_grant {
	u8   random[16];
	u32  handle;                     // what the granter hears under
	u64  now_ms;                     // the granter's clock
}

// THE COUNTER WINDOW, one per session and the session's to keep: a counter
// heard once, and none more than 64 below the highest heard. Checked before
// the tag, so a replay costs no AEAD work; recorded after it, so a forgery
// moves nothing (situ 26.1120, shaped by this tree's review).
replay heard(h: fzn_session_frame_head) [counter = h.counter, window = 64];
