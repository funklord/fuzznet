// A host's answer to another that carries no data -- ok, or why not: project.md
// sec 1076 (in wire/ since sec 1078), the holder's sec 1061. It was a text line the asker read by its first
// letter (sec 455) and parsed (`ok`, `denied WHY`). CODE is what the asker decides
// on; WHY is for a person reading a log and is never parsed.

target buffer;
endian big;

enum code : u8 {
	ok          = 0,   // done
	denied      = 1,   // not this asker's to ask
	malformed   = 2,   // the request was not one
	error       = 3,   // this host could not
	unsupported = 4,   // this host does no such thing
	shedding    = 5,   // this host is loaded and sheds this kind now
	busy        = 6,   // this host is taking turns: ask again
	default     = error,
}

struct message {
	u8    cmd [must_eq = 19];   // FZN_CMD_STATUS, wire/cmd.h; 2, 65 before sec 1087
	code  code;
	u8    why_len [max = 200];
	u8    why[why_len];
}
