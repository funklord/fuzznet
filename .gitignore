# Build output. BUILD_DIR defaults to `.`, so objects and dependency files
# land beside their sources -- the in-place default `build-and-commit.md`
# asks for -- and an out-of-tree BUILD_DIR puts them under whatever it names.
#
# These patterns are what a build produces and nothing else. `make clean`
# removes the same files BY NAME and lists them; this only keeps them out of
# `git status`, so that an untracked file there is somebody's work rather
# than a leftover object.
*.o
*.d

# The test binaries. Named rather than globbed, because a pattern here would
# also hide a source file somebody adds under that name by mistake.
/chain/tests/chain_test
/session/tests/commitment_test
/local/tests/peer_test
/local/tests/peer_fuzz
/local/tests/peer_linux_test
/wire/tests/generated_test
/wire/tests/constants_test
/chunk/tests/agreement_test
/chain/tests/revocation_test
/chain/tests/sign_monocypher_test
/session/tests/hash_monocypher_test
/frame/tests/freshness_test
/chunk/tests/reassembly_test
/chunk/tests/split_test
/chunk/tests/reassembly_fuzz
/chain/tests/chain_fuzz
/frame/tests/freshness_fuzz
/chain/tests/revocation_fuzz
/chunk/tests/roundtrip_fuzz

# An out-of-tree build, if BUILD_DIR names one.
/build/
/san/
/*-coverage/
*.gcov
*.gcda
*.gcno

# Python's, from running tools/style_gate.py.
__pycache__/
/wire/tests/seal_test
/session/tests/aead_monocypher_test
/frame/tests/receive_fuzz
/session/tests/random_test
