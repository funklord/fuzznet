// A conversation line and a mark on one, as situ schemas: the hand-written
// codec is messages/line.c, and these are its checked contract. project.md
// sec 526.
//
// Both are bodies of records on the writing device's FZN_MESSAGE_STREAM
// (3), with the contact's key as the record's subject. A line's text is
// sealed under the conversation's key for its month (the epoch), kept
// outside the journal, so a rule that trims a month destroys that key and
// leaves the records as shells. A text longer than one record holds takes two
// line records, parts 0 and 1, written one after the other.

target buffer;
endian big;

enum fzn_message_direction : u8 {
	out = 1,	// this user sent it
	in  = 2,	// the contact sent it
}

struct fzn_message_line {
	u8                     version [must_eq = 1];   //  0
	fzn_message_direction  direction;               //  1
	u8                     part [max = 1];          //  2 this record's part, from 0
	u8                     parts [min = 1, max = 2];//  3 how many the text takes
	u8                     id[16];                  //  4 the caller's message id
	u64                    stime;                   // 20 the sender's time, ms
	u32                    epoch;                   // 28 months since 1970-01, the key's
	u8                     nonce[24];               // 32 drawn at random
	u8                     tag[16];                 // 56 the AEAD tag over this part
	u8                     text[remaining];         // 72 sealed, at most 440 bytes
}

enum fzn_message_state : u8 {
	delivered     = 1,	// the contact's host took it
	settled       = 2,	// the contact's user realm has it
	handed_over   = 3,	// given to another of the user's devices to send
	not_delivered = 4,	// no device of the user's could send it (sec 521)
}

// A conversation read up to a line, kind 0x237, sec 528: the newest such
// record, wherever written, is the conversation's read position.
struct fzn_message_read {
	u8                     version [must_eq = 1];   //  0
	u8                     id[16];                  //  1 the line read up to
}

struct fzn_message_mark {
	u8                     version [must_eq = 1];   //  0
	fzn_message_direction  direction;               //  1 the line's
	fzn_message_state      state;                   //  2
	u8                     id[16];                  //  3 the line's id
}

// A LINE AS THE STORE KEEPS IT, secs 536 and 539: persist slot 37, one row
// per line a conversation's index names, under a hash of the writing device
// and the last part's sequence. The journal carries lines between devices
// for its window; this row is what is left when the journal has let them go.
//
// KEPT OPENED (sec 539): data is stored decrypted unless staying sealed buys
// something, and a row is never retransmitted. So a row holds the line's
// text once its key has been here, and holds its parts still sealed -- the
// line records' bodies as written -- only while it waits for that key. A
// trimmed month's rows keep their head and hold neither.
struct fzn_message_stored {
	u8                     version [must_eq = 2];   //   0
	u8                     contact[32];             //   1 the record's subject
	u8                     device[32];              //  33 the device that wrote it
	u64                    seq;                     //  65 its last part's, there
	u64                    written_at;              //  73 when the device wrote it, ms
	u64                    stime;                   //  81 the sender's time, ms
	fzn_message_direction  direction;               //  89
	u8                     id[16];                  //  90
	u32                    epoch;                   // 106 the key's month
	u8                     parts [min = 1, max = 2];// 110 how many the text takes
	u8                     opened [max = 1];        // 111 1: the text is below
	u16                    text_len [max = 512];    // 112 0 unless opened
	u8                     text[text_len];          // 114 the line's text, opened
	u8                     held [max = 2];          // parts sealed: all while waiting, else 0
	fzn_message_stored_part sealed[held];
}

struct fzn_message_stored_part {
	u16                    len [min = 72, max = 512];
	u8                     body[len];               // a fzn_message_line, sealed
}
