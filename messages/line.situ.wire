# situ wire signature v2
# schema: line.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum fzn_message_direction : u8 unknown=error
  out=1 in=2

enum fzn_message_state : u8 unknown=error
  delivered=1 settled=2 handed_over=3 not_delivered=4

struct fzn_message_line size=72..
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         fzn_message_direction direction
  @0x0002   1         u8         part  max=1
  @0x0003   1         u8         parts  min=1 max=2
  @0x0004   16        u8         id  big
  @0x0014   8         u64        stime  big
  @0x001c   4         u32        epoch  big
  @0x0020   24        u8         nonce  big
  @0x0038   16        u8         tag  big
  @0x0048   0..       u8         text  sized-by=remaining

struct fzn_message_mark size=19
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         fzn_message_direction direction
  @0x0002   1         fzn_message_state state
  @0x0003   16        u8         id  big

struct fzn_message_read size=17
  @0x0000   1         u8         version  must_eq=1
  @0x0001   16        u8         id  big

struct fzn_message_stored size=115..1655
  @0x0000   1         u8         version  must_eq=2
  @0x0001   32        u8         contact  big
  @0x0021   32        u8         device  big
  @0x0041   8         u64        seq  big
  @0x0049   8         u64        written_at  big
  @0x0051   8         u64        stime  big
  @0x0059   1         fzn_message_direction direction
  @0x005a   16        u8         id  big
  @0x006a   4         u32        epoch  big
  @0x006e   1         u8         parts  min=1 max=2
  @0x006f   1         u8         opened  max=1
  @0x0070   2         u16        text_len  big max=512
  @0x0072   0..512    u8         text  sized-by=text_len
  ~         1         u8         held  max=2
  ~         0..1028   fzn_message_stored_part sealed  sized-by=held

struct fzn_message_stored_part size=74..514
  @0x0000   2         u16        len  big min=72 max=512
  @0x0002   72..512   u8         body  big sized-by=len
