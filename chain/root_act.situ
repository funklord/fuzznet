// The root records as situ schemas: the hand-written codec is
// chain/root_log.c, and this is its checked contract, the way
// chain/revocation.situ is revocation.c's. project.md secs 405, 418, 476.
//
// The body of each is `authenticated` and the signature a
// `checksum ... covers(body)`; Ed25519 is extern, so no codec.
//
// The file is named for the root-log entry it described from sec 404 until
// sec 509 retired it: a key's acts are its journal stream now. The name is
// kept so the schema keeps its place in the coverage.

target buffer;
endian big;

// A root adding another, sec 405. Logged by the adder as an act.
struct fzn_root_add {
	authenticated body {
		u8  version [must_eq = 1];       // 0
		u8  object [must_eq = 140];      // 1  (FZN_OBJECT_ROOT_ADD)
		u8  adder[32];                   // 2  FZN_ROOT_SET_OFF_SIGNER
		u8  added[32];                   // 34 FZN_ROOT_SET_OFF_SUBJECT
	}
	// covers(body) = bytes 0..65, FZN_ROOT_ADD_BODY_LEN.
	checksum u8 signature[64] covers(body); // 66
}

// A root removing another at a cut in the removed root's log, sec 405. An
// all-zero cut leaves nothing of the removed root standing.
struct fzn_root_remove {
	authenticated body {
		u8  version [must_eq = 1];       // 0
		u8  object [must_eq = 141];      // 1  (FZN_OBJECT_ROOT_REMOVE)
		u8  remover[32];                 // 2  FZN_ROOT_SET_OFF_SIGNER
		u8  removed[32];                 // 34 FZN_ROOT_SET_OFF_SUBJECT
		u8  cut[32];                     // 66 FZN_ROOT_SET_OFF_CUT
	}
	// covers(body) = bytes 0..97, FZN_ROOT_REMOVE_BODY_LEN.
	checksum u8 signature[64] covers(body); // 98
}

// A root setting the estate's k, sec 418, after the setting whose hash is
// `replaces` (all-zero for none). Logged by the setter as a setting.
struct fzn_quorum_set {
	authenticated body {
		u8  version [must_eq = 1];       // 0
		u8  object [must_eq = 144];      // 1  (FZN_OBJECT_QUORUM_SET)
		u8  setter[32];                  // 2  FZN_QUORUM_SET_OFF_SETTER
		u8  replaces[32];                // 34 FZN_QUORUM_SET_OFF_REPLACES
		u8  k [min = 1];                 // 66 FZN_QUORUM_SET_OFF_K
	}
	// covers(body) = bytes 0..66, FZN_QUORUM_SET_BODY_LEN.
	checksum u8 signature[64] covers(body); // 67
}

// A root setting one of the estate's retention rules, sec 476: the rule's
// line, NUL-padded, after the record whose hash is `replaces`; no text
// removes the rule it replaces. Logged by the setter as a setting.
struct fzn_retention_set {
	authenticated body {
		u8  version [must_eq = 1];       // 0
		u8  object [must_eq = 145];      // 1  (FZN_OBJECT_RETENTION_SET)
		u8  setter[32];                  // 2  FZN_RETENTION_SET_OFF_SETTER
		u8  replaces[32];                // 34 FZN_RETENTION_SET_OFF_REPLACES
		u8  text[128];                   // 66 FZN_RETENTION_SET_OFF_TEXT
	}
	// covers(body) = bytes 0..193, FZN_RETENTION_SET_BODY_LEN.
	checksum u8 signature[64] covers(body); // 194
}
