// The revocation record as a situ schema -- converted from hand-written C
// (chain/revocation.h) the way chain/hop.situ was, and since sec 1364 opened
// and written through the code situ generates from it (`chain/revocation.c`),
// a withdrawal's two rules `when`s; `_record`, so the generated file's name
// meets no source's.
//
// A revocation withdraws a capability from a grantee; a withdrawal (same
// layout, different object byte) undoes one -- which is why the object is an
// enum of the two values fzn_revocation_validate accepts, and the version is
// carried as a must_eq, the way hop.situ carries its shape constraints. The
// body is an `authenticated` region and the signature a `checksum ...
// covers(body)`, so situ knows it covers bytes 0 through
// FZN_REVOCATION_BODY_LEN-1; no codec, since Ed25519 is extern, as hop.situ.

target buffer;
endian big;

// The object byte is one of TWO values, not one: fzn_revocation_validate
// (revocation.c) accepts a revocation or a withdrawal and refuses the rest,
// so this is an enum rather than a `must_eq` like the other signed objects.
enum fzn_revocation_kind : u8 {
	revocation = 129,       // FZN_OBJECT_REVOCATION
	withdrawal = 133,       // FZN_OBJECT_WITHDRAWAL
}

struct fzn_revocation {
	authenticated body {
		u8  version [must_eq = 1];       // FZN_REV_OFF_VERSION 0 (FZN_SIGNED_VERSION)
		fzn_revocation_kind object;      // FZN_REV_OFF_OBJECT  1
		u8  capability[32];      // FZN_REV_OFF_CAPABILITY 2
		u8  grantee[32];         // FZN_REV_OFF_GRANTEE    34
		u8  issuer[32];          // FZN_REV_OFF_ISSUER     66
		u64 issued_at;           // FZN_REV_OFF_ISSUED_AT  98
		u8  supersedes[32];      // FZN_REV_OFF_SUPERSEDES 106  (the rev-id)
		u64 epoch;               // FZN_REV_OFF_EPOCH      138  (sec 400)
		u8  cut[32];             // FZN_REV_OFF_CUT        146  (sec 496)
	}
	// covers(body) = bytes 0..177, FZN_REVOCATION_BODY_LEN. Ed25519 is
	// extern, so no codec: the caller signs and verifies.
	checksum u8 signature[64] covers(body); // FZN_REV_OFF_SIGNATURE 178
}

// An admin's confirmation of another's admin grant, sec 414: the hop that
// granted it, by its hash. Admitted by fzn_revocation_confirm_admit.
struct fzn_admin_confirm {
	authenticated body {
		u8  version [must_eq = 1];       // 0 (FZN_SIGNED_VERSION)
		u8  object [must_eq = 143];      // 1 (FZN_OBJECT_ADMIN_CONFIRM)
		u8  confirmer[32];               // 2  FZN_ADMIN_CONFIRM_OFF_CONFIRMER
		u8  grant[32];                   // 34 FZN_ADMIN_CONFIRM_OFF_GRANT
	}
	// covers(body) = bytes 0..65, FZN_ADMIN_CONFIRM_BODY_LEN.
	checksum u8 signature[64] covers(body); // 66
}

// A WITHDRAWAL MUST NAME SOMETHING: one naming no revocation matches none,
// and stored would answer "not revoked" for a pair it never undid.
when fzn_revocation.object == 133 && sum(fzn_revocation.supersedes) == 0
	refuse withdrawal_names_nothing
	"a withdrawal names no revocation";
// NOR MAY A WITHDRAWAL DRAW A LINE, sec 496: undoing a vote restores
// everything, and a cut on one would be a second meaning for one field.
when fzn_revocation.object == 133 && sum(fzn_revocation.cut) != 0
	refuse withdrawal_draws_a_line
	"a withdrawal draws a cut";
