// The signed record as a situ schema -- converted from hand-written C
// (record/record.h) the way chain/hop.situ and chain/manifest.situ were.
// VARIABLE LENGTH: a fixed header, then a body sized by the body_len field,
// then the signature. Measured against the committed FZN_RECORD_OFF_*
// constants before anything is generated.
//
// The signature covers bytes 0 through the last body byte (the whole record
// but the signature). Here it is opaque bytes; this measures the offsets
// alone, as hop.situ does. The body uses the same form frame.situ uses for
// its payload -- u8 payload[head.length] -- sized by a prior field.
//
// stream and kind are read as big-endian 32-bit values (fzn_record_stream /
// fzn_record_kind call fzn_get_be32), so they are u32 rather than u8[4].

target buffer;
endian big;

struct fzn_record {
	u8  version;             // FZN_RECORD_OFF_VERSION    0  (FZN_SIGNED_VERSION)
	u8  object;              // FZN_RECORD_OFF_OBJECT     1  (FZN_OBJECT_RECORD)
	u8  issuer[32];          // FZN_RECORD_OFF_ISSUER     2  (FZN_PUBKEY_LEN)
	u8  subject[32];         // FZN_RECORD_OFF_SUBJECT    34 (FZN_SUBJECT_LEN)
	u32 stream;              // FZN_RECORD_OFF_STREAM     66
	u32 kind;                // FZN_RECORD_OFF_KIND       70
	u64 seq;                 // FZN_RECORD_OFF_SEQ        74
	u64 issued_at;           // FZN_RECORD_OFF_ISSUED_AT  82
	u16 body_len  [max = 512]; // FZN_RECORD_OFF_BODY_LEN 90 (max = FZN_RECORD_BODY_MAX)
	u8  body[body_len];      // FZN_RECORD_OFF_BODY       92 = FZN_RECORD_HEADER_LEN
	u8  signature[64];       // at 92 + body_len          (FZN_SIG_LEN)
}
