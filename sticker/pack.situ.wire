# situ wire signature v2
# schema: pack.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

struct fzn_sticker_entry size=41..1006
  @0x0000   2         u16        id  big
  @0x0002   1         u8         type  min=1 max=7
  @0x0003   2         u16        flags  big max=7
  @0x0005   1         u8         description_len  min=1 max=96
  @0x0006   1..96     u8         description  sized-by=description_len
  ~         1         u8         keyword_count  max=32
  ~         0..800    fzn_sticker_keyword keywords  sized-by=keyword_count
  ~         2         u16        text_limit  big
  ~         2         u16        text_x  big
  ~         2         u16        text_y  big
  ~         2         u16        text_w  big
  ~         2         u16        text_h  big
  ~         4         u32        audio_offset  big
  ~         4         u32        audio_len  big
  ~         1         u8         rendition_count  min=1 max=6
  ~         14..84    fzn_sticker_rendition renditions  big sized-by=rendition_count

struct fzn_sticker_keyword size=2..25
  @0x0000   1         u8         len  min=1 max=24
  @0x0001   1..24     u8         text  sized-by=len

struct fzn_sticker_pack size=48..4295031734
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         name_len  max=48
  @0x0002   0..48     u8         name  sized-by=name_len
  ~         1         u8         count  min=1 max=64
  ~         41..64384 fzn_sticker_entry entries  big sized-by=count
  ~         4         u32        data_len  big
  ~         0..4294967295 u8         data  sized-by=data_len

struct fzn_sticker_rendition size=14
  @0x0000   1         u8         role  min=1 max=4
  @0x0001   1         u8         format  min=1 max=4
  @0x0002   2         u16        width  big
  @0x0004   2         u16        height  big
  @0x0006   4         u32        offset  big
  @0x000a   4         u32        len  big min=1
