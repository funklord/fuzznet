// A sticker pack as a situ schema, sec 679: the holder's choice of
// 2026-10-21 over fuzzypickles' stored zip of a CBOR manifest. One layout,
// no container: a rendition or a sound is an offset and a length into the
// pack's data area, so there is no file name inside a pack to resolve or
// to refuse. `sticker/pack.h` encodes and decodes it by hand, its rules
// the ones fuzzypickles' decoder kept (`core/src/sticker.c`, read at their
// 51e789e).
//
// VERSION 2, sec 702: ids of 64 bits from the art, LINE's ids, no cap of
// 64 stickers, and a description and a name that may be empty. Version 1
// -- `u16 id`, `u8 count [max = 64]`, `description_len [min = 1]`, no
// LINE fields -- is still read by `sticker/pack.c` and written by nothing.
//
// VERSION 3, sec 859: the pack's own id from its art, and a text box's
// fill, ink and turn. Version 2 -- this layout without `id` and without
// the three after `text_h` -- is still read, and written by nothing.

target buffer;
endian big;

struct fzn_sticker_keyword {
	u8 len [min = 1, max = 24];
	u8 text[len];
}

struct fzn_sticker_rendition {
	u8  role [min = 1, max = 4];     // thumb, inline, main, popup
	u8  format [min = 1, max = 4];   // lottie, apng, webp, png
	u16 width;
	u16 height;
	u32 offset;                      // into the pack's data area
	u32 len [min = 1];
}

struct fzn_sticker_entry {
	u64 id [min = 1];
	u64 line_id;                     // LINE's sticker id; 0: none
	u8  type [min = 1, max = 7];     // static, animated, popup, effect, message, name, emoji
	u16 flags [max = 7];             // sound 1, big 2, animated 4
	u8  description_len [max = 96];
	u8  description[description_len];
	u8  keyword_count [max = 32];
	fzn_sticker_keyword keywords[keyword_count];
	u16 text_limit;                  // 0: the sticker takes no text
	u16 text_x;
	u16 text_y;
	u16 text_w;
	u16 text_h;
	u32 text_fill;                   // 0xRRGGBBAA under the words; 0: none
	u32 text_ink;                    // 0xRRGGBBAA of the words; 0: the client's
	u16 text_turn [max = 359];       // degrees clockwise
	u32 audio_offset;
	u32 audio_len;                   // 0: no sound
	u8  rendition_count [min = 1, max = 6];
	fzn_sticker_rendition renditions[rendition_count];
}

struct fzn_sticker_pack {
	u8  version [must_eq = 3];
	u64 id [min = 1];                // the pack's own, from its art
	u64 line_package;                // LINE's package id; 0: none
	u8  name_len [max = 48];
	u8  name[name_len];
	u32 count [min = 1];
	fzn_sticker_entry entries[count];
	u32 data_len;
	u8  data[data_len];
}
