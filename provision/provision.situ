// The provisioning card as a situ schema -- the nested case that reaches
// across modules: it imports the hop (chain) and the prekey record (prekey)
// and references them, so a card carries exactly one encoding of each.
// Measured against the FZN_PROVISION_OFF_* macros in provision/provision.h.
//
// A sponsor's signed statement handing a device a root to pin, a capability
// (the hop), and the sponsor's prekey to agree a session with. The signature
// covers the body -- exactly the FZN_PROVISION_BODY_LEN bytes fzn_provision_sign
// and fzn_provision_verify pass -- and is bound as the sibling schemas bind
// theirs. The body NESTS two structs that each cover their own body, which
// crashed situc until situ 74739d7 (project.md sec 308); a hop or prekey byte
// is therefore covered twice, by its own signature and by the card's.

import "../chain/hop.situ";
import "../prekey/prekey.situ";
import "../chain/root_act.situ";

target buffer;
endian big;

// SINCE sec 391 the card names the ESTATE's root and carries the chain from it
// to the device, and the SPONSOR -- the last hop's grantor, the prekey's host
// -- signs it, so any member entitled to admit can while the root stays
// offline. 134 was the one-hop card the root signed, retired rather than
// reinterpreted, and 138 the card of sec 391.
//
// SINCE sec 410 the card is 142 (FZN_OBJECT_CARD) and carries a PROOF after
// the chain: up to three root-adds from the estate's root to the root the
// chain starts at, each by the root the one before added. The device pins the
// genesis root; the proof is what lets a chain start at another. A card with
// no proof is the sec 391 card with one zero byte more.
struct fzn_provision_card {
	authenticated body {
		u8  version [must_eq = 1];    // FZN_PROVISION_OFF_VERSION   0 (FZN_SIGNED_VERSION)
		u8  object  [must_eq = 142];  // FZN_PROVISION_OFF_OBJECT    1 (FZN_OBJECT_CARD)
		u8  root[32];                // FZN_PROVISION_OFF_ROOT      2
		u8  hop_count [min = 1, max = 8]; // FZN_PROVISION_OFF_HOP_COUNT 34
		fzn_chain_hop     chain[hop_count]; // FZN_PROVISION_OFF_CHAIN 35
		u8  proof_count [max = 3];   // FZN_PROVISION_OFF_PROOF_COUNT(n)
		fzn_root_add      proof[proof_count]; // FZN_PROVISION_OFF_PROOF(n)
		fzn_prekey_record prekey;    // FZN_PROVISION_OFF_PREKEY(n, p)
		u64 expires_at;              // FZN_PROVISION_OFF_EXPIRES_AT(n, p)
	}
	// No codec: Ed25519 is extern, so the caller signs and verifies. The
	// signer is the sponsor, which the schema cannot name: it is the last
	// hop's grantor, checked by fzn_provision_verify.
	checksum u8 signature[64] covers(body); // FZN_PROVISION_OFF_SIGNATURE(n, p)
}
