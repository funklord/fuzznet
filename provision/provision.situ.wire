# situ wire signature v2
# schema: provision.situ
#
# What the bytes mean, and nothing about what they cost. Committed and
# checked so that a change here is a change somebody reviews.
#
# One line per member: where it starts, how wide it is, and every
# constraint a sender has to satisfy or a receiver may rely on.
# Positions are byte offsets, or byte:bit off a boundary; `~` marks one
# the data decides rather than the schema.
#
# A construct whose contract is a list rather than an extent -- a
# variant's arms, a tlv region's grammar, an indexed region's offset
# table, the bytes a tag covers -- states it on `name what: value`
# lines below the members, one line per entry so that a diff names the
# entry that moved.

endian big
target buffer

enum fzn_root_act_kind : u8 unknown=error
  grant=1 revocation=2 roster=3 root_add=4 root_remove=5 setting=6

struct fzn_chain_hop size=179
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=128
  @0x0002   32        u8         grantor  big
  @0x0022   32        u8         grantee  big
  @0x0042   32        u8         capability  big
  @0x0062   8         u64        issued_at  big
  @0x006a   8         u64        expires_at  big
  @0x0072   1         u8         delegable  max=1
  @0x0073   64        u8         signature
  signature covers: body capability delegable expires_at grantee grantor issued_at object version

struct fzn_prekey_record size=138
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=132
  @0x0002   32        u8         host  big
  @0x0022   32        u8         prekey  big
  @0x0042   8         u64        created_at  big
  @0x004a   64        u8         signature
  signature covers: body created_at host object prekey version

struct fzn_provision_card size=425..2068
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=142
  @0x0002   32        u8         root  big
  @0x0022   1         u8         hop_count  min=1 max=8
  @0x0023   179..1432 fzn_chain_hop chain  big sized-by=hop_count
  ~         1         u8         proof_count  max=3
  ~         0..390    fzn_root_add proof  sized-by=proof_count
  ~         138       fzn_prekey_record prekey  big
  ~         8         u64        expires_at  big
  ~         64        u8         signature
  chain[].signature covers: chain[].body chain[].capability chain[].delegable chain[].expires_at chain[].grantee chain[].grantor chain[].issued_at chain[].object chain[].version
  proof[].signature covers: proof[].added proof[].adder proof[].body proof[].object proof[].version
  prekey.signature covers: prekey.body prekey.created_at prekey.host prekey.object prekey.prekey prekey.version
  signature covers: body chain chain[] chain[].body chain[].capability chain[].delegable chain[].expires_at chain[].grantee chain[].grantor chain[].issued_at chain[].object chain[].signature chain[].version expires_at hop_count object prekey prekey.body prekey.created_at prekey.host prekey.object prekey.prekey prekey.signature prekey.version proof proof[] proof[].added proof[].adder proof[].body proof[].object proof[].signature proof[].version proof_count root version

struct fzn_quorum_set size=131
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=144
  @0x0002   32        u8         setter  big
  @0x0022   32        u8         replaces  big
  @0x0042   1         u8         k  min=1
  @0x0043   64        u8         signature
  signature covers: body k object replaces setter version

struct fzn_retention_set size=258
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=145
  @0x0002   32        u8         setter  big
  @0x0022   32        u8         replaces  big
  @0x0042   128       u8         text  big
  @0x00c2   64        u8         signature
  signature covers: body object replaces setter text version

struct fzn_root_act size=171
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=139
  @0x0002   32        u8         root  big
  @0x0022   8         u64        seq  big
  @0x002a   32        u8         prev  big
  @0x004a   1         fzn_root_act_kind kind
  @0x004b   32        u8         act  big
  @0x006b   64        u8         signature
  signature covers: act body kind object prev root seq version

struct fzn_root_add size=130
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=140
  @0x0002   32        u8         adder  big
  @0x0022   32        u8         added  big
  @0x0042   64        u8         signature
  signature covers: added adder body object version

struct fzn_root_remove size=162
  @0x0000   1         u8         version  must_eq=1
  @0x0001   1         u8         object  must_eq=141
  @0x0002   32        u8         remover  big
  @0x0022   32        u8         removed  big
  @0x0042   32        u8         cut  big
  @0x0062   64        u8         signature
  signature covers: body cut object removed remover version
