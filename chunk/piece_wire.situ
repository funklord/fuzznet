// One erasure-coded piece of an archived item, project.md sec 595: kept as
// a file under ARCHIVE/pieces/, named by its item's id and its index. The
// pieces of one item rebuild it through chunk/erasure.h, and the rebuilt
// bytes must hash to `item_id`, which is the only check a piece needs: one
// wrong in a byte rebuilds an item that does not. node/pieces.c checks a
// whole piece kept from the wire, and node/piece_buckets.c writes and reads
// the cut and the release, through the code situ generates from this (sec
// 1371); `_wire`, so the generated file's name meets no source's. A piece
// file itself is written and read in two steps -- its head, then up to 64
// MiB of piece -- so that path stays node/pieces.c's own.
//
// The `when`s below say k + m is at most 32 and `index` below k + m; what
// the schema cannot say and the codec checks is that `piece_len` is
// item_len / k rounded up.

target buffer;
endian big;

struct fzn_erasure_piece {
	u8   version [must_eq = 1];
	u8   kind [max = 1];                      // the bucket kind, node/buckets_row.situ
	u8   item_id[32];                         // the item's bucket id
	u8   host[32];                            // whose item: served to it, sec 599
	u64  item_len [min = 1, max = 67108864];  // a large item's bound, sec 570
	u8   k [min = 1, max = 31];               // data pieces
	u8   m [min = 1, max = 31];               // parity pieces
	u8   index [max = 31];                    // this piece's, data first
	u8   keeper[32];                          // the host it was placed on, sec 601
	u32  piece_len [min = 1, max = 67108864];
	u8   piece[piece_len];
}

// THE PLACEMENT OF ONE ITEM'S PIECES, sec 599: kept by the host that cut
// them, as ARCHIVE/pieces/IDHEX.cut, so it can ask each keeper for its
// piece after letting go of its own copies of them. Keeper i keeps piece i.
struct fzn_erasure_keeper {
	u8   key[32];                             // a host's node key
}

struct fzn_erasure_cut {
	u8   version [must_eq = 1];
	u8   item_id[32];
	u8   k [min = 1, max = 31];
	u8   m [min = 1, max = 31];
	fzn_erasure_keeper keepers[k + m];
}

// A PIECE RELEASED, sec 602: an item of the pieces kind beside the pieces,
// placed in the bucket of a keeper whose piece was moved off it while it
// was away (sec 601). Signed by the item's host -- over
// "fuzznet.piece.release", a NUL and every byte before `sig` -- so only the
// host a piece is of can have its keeper let it go. `marker` is no bucket
// kind, which is what tells it from a piece in the same bucket.
struct fzn_erasure_release {
	u8   version [must_eq = 1];
	u8   marker [must_eq = 255];
	u8   item_id[32];
	u8   host[32];                            // whose item, and the signer
	u8   index [max = 31];
	u8   piece_id[32];                        // the piece let go, by its id
	u8   sig[64];
}

// A CUT OF AT MOST 32 PIECES (FZN_ERASURE_PIECES_MAX), and a piece's index
// inside its cut.
when fzn_erasure_piece.k + fzn_erasure_piece.m > 32
	refuse piece_cut_too_wide
	"a piece of a cut of more than 32 pieces";
when fzn_erasure_piece.index >= fzn_erasure_piece.k + fzn_erasure_piece.m
	refuse index_past_the_cut
	"a piece whose index is past its cut";
when fzn_erasure_cut.k + fzn_erasure_cut.m > 32
	refuse cut_too_wide
	"a placement of more than 32 pieces";
